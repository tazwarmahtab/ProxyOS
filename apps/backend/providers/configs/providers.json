{
  "providers": [
    {
      "name": "nvidia",
      "priority": 1,
      "enabled": true,
      "config": {
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "models": ["nvidia/llama-3.1-nemotron-70b-instruct", "nvidia/nemotron-4-340b-instruct"],
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    {
      "name": "groq",
      "priority": 2,
      "enabled": true,
      "config": {
        "baseUrl": "https://api.groq.com/openai/v1",
        "models": ["llama-3.3-70b-versatile", "mixtral-8x7b-32768", "gemma2-9b-it"],
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    {
      "name": "bonsai",
      "priority": 3,
      "enabled": true,
      "free": true,
      "config": {
        "baseUrl": "https://go.trybons.ai",
        "models": ["auto"],
        "defaultModel": "auto",
        "maxTokens": 4096,
        "headers": {
          "Content-Type": "application/json"
        },
        "note": "Routes to frontier models (Claude, GPT-5, GLM) in stealth mode"
      }
    },
    {
      "name": "zai",
      "priority": 4,
      "enabled": true,
      "free": true,
      "config": {
        "baseUrl": "https://api.z.ai/api/coding/paas/v4",
        "models": ["GLM-4.7-Flash", "GLM-4.7", "GLM-4.5-air"],
        "defaultModel": "GLM-4.7-Flash",
        "maxTokens": 4096,
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    {
      "name": "github-copilot",
      "priority": 5,
      "enabled": true,
      "config": {
        "baseUrl": "https://api.github.com",
        "authType": "bearer",
        "headers": {
          "Accept": "application/json",
          "X-GitHub-Api-Version": "2022-11-28"
        }
      }
    },
    {
      "name": "opencode",
      "priority": 6,
      "enabled": true,
      "config": {
        "baseUrl": "https://api.opencode.ai/v1",
        "model": "opencode/default",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    {
      "name": "openrouter",
      "priority": 7,
      "enabled": true,
      "config": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "models": ["anthropic/claude-3-opus", "anthropic/claude-3.5-sonnet", "openai/gpt-4o"],
        "headers": {
          "Content-Type": "application/json",
          "HTTP-Referer": "https://proxy-os.vercel.app",
          "X-Title": "ProxyOS Backend"
        }
      }
    },
    {
      "name": "anthropic",
      "priority": 8,
      "enabled": true,
      "config": {
        "baseUrl": "https://api.anthropic.com/v1",
        "models": ["claude-3-5-sonnet-20241022", "claude-3-haiku-20240307"],
        "defaultModel": "claude-3-5-sonnet-20241022",
        "maxTokens": 4096,
        "headers": {
          "Content-Type": "application/json",
          "anthropic-version": "2023-06-01"
        }
      }
    }
  ]
}

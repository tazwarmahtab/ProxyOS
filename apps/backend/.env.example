# ProxyOS Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=7860
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT
NODE_ENV=production

# Supabase Configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# LLM Provider (choose one: bonsai, nvidia, groq)
LLM_PROVIDER=bonsai

# Bonsai API (FREE frontier models: Claude, GPT, GLM)
# Get free key at: https://app.trybons.ai
BONSAI_API_KEY=YOUR_BONSAI_API_KEY

# Nvidia NIM API (free tier available)
# Get free key at: https://build.nvidia.com
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_MODEL=z-ai/glm5

# Groq API (fast inference)
# Get free key at: https://console.groq.com
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Google Gemini API (optional, for deep reasoning)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OpenCode API (experimental)
# Get key at: https://opencode.ai
OPENCODE_API_KEY=YOUR_OPENCODE_API_KEY

# OpenRouter API (multi-model)
# Get key at: https://openrouter.ai
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# GitHub Copilot API (optional)
# Get token from GitHub Settings > Developer settings > Personal access tokens
GITHUB_COPILOT_TOKEN=YOUR_GITHUB_COPILOT_TOKEN

# Anthropic API (Claude models)
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Z.ai API (free GLM-4)
# Get key at: https://z.ai
ZAI_API_KEY=YOUR_ZAI_API_KEY

# Telegram Adapter (optional)
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ENABLED=true

# Telegram Security (optional)
TELEGRAM_ALLOWED_USERS=123456789,987654321
TELEGRAM_ADMIN_USERS=123456789

# Telegram Rate Limiting (messages per minute)
TELEGRAM_RATE_LIMIT=20

# Telegram Group Chat Settings
TELEGRAM_GROUPS_ENABLED=false
TELEGRAM_GROUP_MENTION_ONLY=true

# OpenClaw Cloud Fallback
OPENCLOUD_API_URL=https://taz7770-proxyos-openclaw.hf.space/api/agent

# Slack Adapter (optional)
# Get these from your Slack App configuration
SLACK_BOT_TOKEN=xoxb-YOUR-BOT-TOKEN
SLACK_SIGNING_SECRET=YOUR_SIGNING_SECRET
SLACK_APP_TOKEN=xapp-YOUR-APP-TOKEN

# ProxyOS Backend URL (for adapters to call backend)
PROXYOS_BACKEND_URL=http://proxyos-backend:3000

# Tailscale Configuration (optional)
# Get auth key from: https://login.tailscale.com/admin/settings/keys
TS_AUTH_KEY=YOUR_TAILSACLE_AUTH_KEY
TS_HOSTNAME=proxyos-backend

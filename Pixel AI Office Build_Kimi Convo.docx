Phase 1: Database Schema (Supabase)
Run this SQL in your Supabase SQL Editor:

-- Enable necessary extensions

CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- Table 1: Proxy Context Feed (User Inputs)

CREATE TABLE proxy_context (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    raw_input TEXT NOT NULL,
    input_type VARCHAR(20) DEFAULT 'text', -- text, voice, link, file
    project_tag VARCHAR(50),
    energy_gained INT DEFAULT 10,
    status VARCHAR(20) DEFAULT 'unassigned',
    metadata JSONB DEFAULT '{}'
);

-- Table 2: Agent Task Queue (The Swarm's Work)

CREATE TABLE agent_tasks (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    context_id UUID REFERENCES proxy_context(id),
    agent_role VARCHAR(50) NOT NULL CHECK (agent_role IN ('minion', 'scout', 'sage')),
    task_description TEXT NOT NULL,
    task_type VARCHAR(50), -- code, research, strategy, qa
    status VARCHAR(20) DEFAULT 'pending' CHECK (status IN ('pending', 'working', 'success', 'failed', 'halted')),
    priority INT DEFAULT 5,
    output_log TEXT,
    execution_time_ms INT,
    retry_count INT DEFAULT 0,
    lane_id VARCHAR(50) -- Prevents task-clashing
);

-- Table 3: Persistent Agent Memories (Solves Hugging Face Amnesia)

CREATE TABLE agent_memories (
    agent_role VARCHAR(50) PRIMARY KEY CHECK (agent_role IN ('minion', 'scout', 'sage', 'proxy')),
    soul_markdown TEXT NOT NULL,
    memory_markdown TEXT NOT NULL,
    operational_rules JSONB DEFAULT '{}',
    last_updated TIMESTAMPTZ DEFAULT NOW(),
    version INT DEFAULT 1
);

-- Table 4: Execution Logs (Audit Trail)

CREATE TABLE execution_logs (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    task_id UUID REFERENCES agent_tasks(id),
    agent_role VARCHAR(50),
    log_type VARCHAR(20), -- info, warning, error, success
    message TEXT,
    metadata JSONB
);

-- Table 5: Proxy Stats (Gamification)

CREATE TABLE proxy_stats (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    user_id UUID DEFAULT uuid_generate_v4(),
    energy_level INT DEFAULT 50 CHECK (energy_level >= 0 AND energy_level <= 100),
    tasks_completed INT DEFAULT 0,
    projects_active INT DEFAULT 0,
    last_fed TIMESTAMPTZ DEFAULT NOW(),
    achievements JSONB DEFAULT '[]',
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Enable Realtime for live updates

ALTER PUBLICATION supabase_realtime ADD TABLE agent_tasks;
ALTER PUBLICATION supabase_realtime ADD TABLE proxy_context;
ALTER PUBLICATION supabase_realtime ADD TABLE proxy_stats;

-- Indexes for performance

CREATE INDEX idx_tasks_status ON agent_tasks(status);
CREATE INDEX idx_tasks_agent ON agent_tasks(agent_role);
CREATE INDEX idx_context_project ON proxy_context(project_tag);
CREATE INDEX idx_logs_task ON execution_logs(task_id);


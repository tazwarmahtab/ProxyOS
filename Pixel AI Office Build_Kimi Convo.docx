Phase 2: Backend (Hugging Face Docker Space)
Create a new Docker Space on Hugging Face with these files:
Dockerfile

FROM node:18-bullseye-slim

WORKDIR /app

# Install dependencies for browser automation and general tooling

RUN apt-get update && apt-get install -y \
    wget gnupg ca-certificates procps \
    git curl vim \
    && wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | apt-key add - \
    && sh -c 'echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google.list' \
    && apt-get update \
    && apt-get install -y google-chrome-stable fonts-ipafont-gothic fonts-wqy-zenhei fonts-thai-tlwg fonts-kacst fonts-freefont-ttf libxss1 \

    --no-install-recommends \

    && rm -rf /var/lib/apt/lists/*

# Copy package files

COPY package*.json ./

# Install Node dependencies

RUN npm install

# Copy application code

COPY . .

# Create necessary directories

RUN mkdir -p /app/agents/minion /app/agents/scout /app/agents/sage /app/temp

# Expose Hugging Face required port

EXPOSE 7860

# Health check

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:7860/health || exit 1

# Start command

CMD ["node", "server.js"]
package.json

{
  "name": "proxyos-swarm",
  "version": "1.0.0",
  "description": "Autonomous AI Agent Swarm for ProxyOS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.1",
    "cheerio": "^1.0.0-rc.12",
    "puppeteer": "^21.6.1",
    "groq-sdk": "^0.3.0",
    "@google/generative-ai": "^0.2.0"
  }
}
server.js (Complete Backend)

const express = require('express');
const cors = require('cors');
const { createClient } = require('@supabase/supabase-js');
const axios = require('axios');
const fs = require('fs').promises;
const path = require('path');
const cron = require('node-cron');
const { Groq } = require('groq-sdk');
const { GoogleGenerativeAI } = require('@google/generative-ai');

const app = express();
app.use(cors());
app.use(express.json({ limit: '50mb' }));

const PORT = 7860;

// Initialize clients
const supabase = createClient(
    process.env.SUPABASE_URL,
    process.env.SUPABASE_SERVICE_KEY
);

const groq = new Groq({ apiKey: process.env.GROQ_API_KEY });
const genAI = new GoogleGenerativeAI(process.env.GEMINI_API_KEY);

// Agent lane locks (prevents task-clashing)
const activeLanes = new Map();

// ==================== MEMORY MANAGEMENT ====================

async function syncMemoriesOnBoot() {
    console.log('🧠 [SYSTEM] Waking up agents and loading persistent memories...');
    
    try {
        const { data: memories, error } = await supabase
            .from('agent_memories')
            .select('*');
        
        if (error) throw error;
        
        for (const agent of memories) {
            const agentDir = path.join(__dirname, 'agents', agent.agent_role);
            await fs.mkdir(agentDir, { recursive: true });
            
            await fs.writeFile(
                path.join(agentDir, 'soul.md'),
                agent.soul_markdown
            );
            
            await fs.writeFile(
                path.join(agentDir, 'memory.md'),
                agent.memory_markdown
            );
            
            await fs.writeFile(
                path.join(agentDir, 'rules.json'),
                JSON.stringify(agent.operational_rules, null, 2)
            );
            
            console.log(`✅ Loaded memory for ${agent.agent_role}`);
        }
        
        console.log('🚀 [SYSTEM] All agents online and memory-synced');
    } catch (err) {
        console.error('❌ [SYSTEM] Memory sync failed:', err);
    }
}

async function persistMemory(agentRole, memoryContent) {
    try {
        await supabase
            .from('agent_memories')
            .upsert({
                agent_role: agentRole,
                memory_markdown: memoryContent,
                last_updated: new Date().toISOString()
            });
    } catch (err) {
        console.error(`❌ Failed to persist memory for ${agentRole}:`, err);
    }
}

// ==================== LLM ROUTING ====================

async function routeToLLM(agentRole, prompt, context, taskType) {
    // Route based on task characteristics
    const useGemini = taskType === 'deep_reasoning' || taskType === 'strategy' || prompt.length > 4000;
    
    if (useGemini) {
        const model = genAI.getGenerativeModel({ model: "gemini-pro" });
        const result = await model.generateContent(prompt);
        return result.response.text();
    } else {
        const completion = await groq.chat.completions.create({
            messages: [
                { role: "system", content: context },
                { role: "user", content: prompt }
            ],
            model: "llama3-70b-8192",
            temperature: 0.3,
            max_tokens: 4096
        });
        return completion.choices[0].message.content;
    }
}

// ==================== AGENT IMPLEMENTATIONS ====================

class AgentMinion {
    constructor() {
        this.role = 'minion';
        this.capabilities = ['code_generation', 'deployment', 'automation', 'github_actions'];
    }
    
    async execute(task) {
        const startTime = Date.now();
        
        try {
            // Read agent context
            const soul = await fs.readFile(path.join(__dirname, 'agents/minion/soul.md'), 'utf8');
            const memory = await fs.readFile(path.join(__dirname, 'agents/minion/memory.md'), 'utf8');
            
            const prompt = `
TASK: ${task.task_description}
PROJECT: ${task.project_tag || 'general'}

Execute this task as the Minion. Return:
1. Shell commands to execute (if any)
2. Code blocks (if generating code)
3. Deployment instructions
4. GitHub Actions workflow (if applicable)

Be concise. No conversational filler.`;
            
            const result = await routeToLLM('minion', prompt, soul + '\n' + memory, 'code');
            
            // Simulate execution (in production, this would actually run commands)
            const executionLog = {
                agent: 'minion',
                task: task.id,
                output: result,
                commands_extracted: this.extractCommands(result),
                estimated_deployment_time: '45s',
                timestamp: new Date().toISOString()
            };
            
            // Update memory with execution
            const newMemory = memory + `\n\n## Execution ${new Date().toISOString()}\n- Task: ${task.task_description}\n- Status: Completed\n- Output: ${result.substring(0, 200)}...`;
            await fs.writeFile(path.join(__dirname, 'agents/minion/memory.md'), newMemory);
            await persistMemory('minion', newMemory);
            
            return {
                status: 'success',
                output: result,
                execution_time: Date.now() - startTime,
                log: executionLog
            };
            
        } catch (err) {
            return {
                status: 'failed',
                error: err.message,
                execution_time: Date.now() - startTime
            };
        }
    }
    
    extractCommands(text) {
        const commands = [];
        const codeBlockRegex = /```(?:bash|shell)?\n([\s\S]*?)```/g;
        let match;
        while ((match = codeBlockRegex.exec(text)) !== null) {
            commands.push(...match[1].split('\n').filter(cmd => cmd.trim() && !cmd.startsWith('#')));
        }
        return commands;
    }
}

class AgentScout {
    constructor() {
        this.role = 'scout';
        this.capabilities = ['web_scraping', 'api_research', 'data_parsing', 'source_verification'];
    }
    
    async execute(task) {
        const startTime = Date.now();
        
        try {
            const soul = await fs.readFile(path.join(__dirname, 'agents/scout/soul.md'), 'utf8');
            const memory = await fs.readFile(path.join(__dirname, 'agents/scout/memory.md'), 'utf8');
            
            const prompt = `
RESEARCH TASK: ${task.task_description}
TARGET: ${task.project_tag || 'general'}

Gather intelligence and return:
1. Structured data in Markdown tables
2. Source citations
3. Actionable insights
4. Confidence scores (0-100)

Focus on primary sources. Structure for immediate use.`;
            
            const result = await routeToLLM('scout', prompt, soul + '\n' + memory, 'research');
            
            // Simulate web scraping if URLs mentioned
            const urls = this.extractUrls(task.task_description);
            const scrapedData = urls.length > 0 ? await this.scrapeUrls(urls) : null;
            
            const newMemory = memory + `\n\n## Research ${new Date().toISOString()}\n- Query: ${task.task_description}\n- Sources: ${urls.length}\n- Findings: ${result.substring(0, 200)}...`;
            await fs.writeFile(path.join(__dirname, 'agents/scout/memory.md'), newMemory);
            await persistMemory('scout', newMemory);
            
            return {
                status: 'success',
                output: result,
                scraped_data: scrapedData,
                execution_time: Date.now() - startTime
            };
            
        } catch (err) {
            return {
                status: 'failed',
                error: err.message,
                execution_time: Date.now() - startTime
            };
        }
    }
    
    extractUrls(text) {
        const urlRegex = /(https?:\/\/[^\s]+)/g;
        return text.match(urlRegex) || [];
    }
    
    async scrapeUrls(urls) {
        // Simplified scraping - in production would use Puppeteer
        return urls.map(url => ({
            url,
            status: 'scraped',
            title: 'Title extracted',
            content_length: 1500
        }));
    }
}

class AgentSage {
    constructor() {
        this.role = 'sage';
        this.capabilities = ['qa_review', 'strategy', 'polish', 'standards_enforcement'];
    }
    
    async execute(task) {
        const startTime = Date.now();
        
        try {
            const soul = await fs.readFile(path.join(__dirname, 'agents/sage/soul.md'), 'utf8');
            const memory = await fs.readFile(path.join(__dirname, 'agents/sage/memory.md'), 'utf8');
            
            // Fetch context from other agents if reviewing
            let contextData = '';
            if (task.context_id) {
                const { data: context } = await supabase
                    .from('proxy_context')
                    .select('*')
                    .eq('id', task.context_id)
                    .single();
                if (context) contextData = context.raw_input;
            }
            
            const prompt = `
REVIEW TASK: ${task.task_description}
CONTEXT: ${contextData}

Review with ruthless precision. Return:
1. PASS/FAIL verdict
2. Specific issues (if any)
3. Polish recommendations
4. Multi-country operational considerations

Apply Apple-grade standards. Cut all bloat.`;
            
            const result = await routeToLLM('sage', prompt, soul + '\n' + memory, 'strategy');
            
            const newMemory = memory + `\n\n## Review ${new Date().toISOString()}\n- Task: ${task.task_description}\n- Verdict: ${result.includes('PASS') ? 'PASS' : 'NEEDS_WORK'}`;
            await fs.writeFile(path.join(__dirname, 'agents/sage/memory.md'), newMemory);
            await persistMemory('sage', newMemory);
            
            return {
                status: 'success',
                output: result,
                verdict: result.includes('PASS') ? 'pass' : 'fail',
                execution_time: Date.now() - startTime
            };
            
        } catch (err) {
            return {
                status: 'failed',
                error: err.message,
                execution_time: Date.now() - startTime
            };
        }
    }
}

// Agent instances
const agents = {
    minion: new AgentMinion(),
    scout: new AgentScout(),
    sage: new AgentSage()
};

// ==================== TASK ORCHESTRATION ====================

async function processTask(taskId) {
    // Acquire lane lock to prevent clashing
    const laneId = `lane-${taskId}`;
    if (activeLanes.has(laneId)) {
        console.log(`⚠️ Task ${taskId} already in progress`);
        return;
    }
    activeLanes.set(laneId, true);
    
    try {
        // Fetch task
        const { data: task, error } = await supabase
            .from('agent_tasks')
            .select('*, proxy_context(*)')
            .eq('id', taskId)
            .single();
        
        if (error || !task) throw new Error('Task not found');
        
        // Update status to working
        await supabase
            .from('agent_tasks')
            .update({ status: 'working', updated_at: new Date().toISOString() })
            .eq('id', taskId);
        
        // Log start
        await supabase.from('execution_logs').insert({
            task_id: taskId,
            agent_role: task.agent_role,
            log_type: 'info',
            message: `Starting execution: ${task.task_description}`
        });
        
        // Execute
        const agent = agents[task.agent_role];
        const result = await agent.execute(task);
        
        // Update task with results
        await supabase
            .from('agent_tasks')
            .update({
                status: result.status,
                output_log: JSON.stringify(result),
                execution_time_ms: result.execution_time,
                updated_at: new Date().toISOString()
            })
            .eq('id', taskId);
        
        // Log completion
        await supabase.from('execution_logs').insert({
            task_id: taskId,
            agent_role: task.agent_role,
            log_type: result.status === 'success' ? 'success' : 'error',
            message: result.status === 'success' ? 'Execution completed' : result.error,
            metadata: result
        });
        
        console.log(`✅ Task ${taskId} completed by ${task.agent_role}`);
        
    } catch (err) {
        console.error(`❌ Task ${taskId} failed:`, err);
        
        await supabase
            .from('agent_tasks')
            .update({
                status: 'failed',
                output_log: JSON.stringify({ error: err.message }),
                updated_at: new Date().toISOString()
            })
            .eq('id', taskId);
            
    } finally {
        activeLanes.delete(laneId);
    }
}

// Background worker: Process pending tasks
async function processQueue() {
    const { data: pendingTasks, error } = await supabase
        .from('agent_tasks')
        .select('*')
        .eq('status', 'pending')
        .order('priority', { ascending: false })
        .order('created_at', { ascending: true })
        .limit(3); // Process max 3 concurrent
    
    if (error || !pendingTasks) return;
    
    for (const task of pendingTasks) {
        // Check if agent is already working on something
        const { data: activeTasks } = await supabase
            .from('agent_tasks')
            .select('*')
            .eq('agent_role', task.agent_role)
            .eq('status', 'working');
        
        if (activeTasks && activeTasks.length === 0) {
            processTask(task.id);
        }
    }
}

// Cron job: Check queue every 10 seconds
cron.schedule('*/10 * * * * *', processQueue);

// ==================== API ROUTES ====================

// Health check
app.get('/', (req, res) => {
    res.json({
        status: 'ProxyOS Swarm Online',
        agents: ['minion', 'scout', 'sage'],
        uptime: process.uptime(),
        timestamp: new Date().toISOString()
    });
});

app.get('/health', (req, res) => {
    res.json({ status: 'healthy' });
});

// Feed context to Proxy (from frontend)
app.post('/api/feed-context', async (req, res) => {
    const { raw_input, input_type = 'text', project_tag, metadata = {} } = req.body;
    
    try {
        // 1. Store context
        const { data: context, error: ctxError } = await supabase
            .from('proxy_context')
            .insert({
                raw_input,
                input_type,
                project_tag,
                metadata,
                energy_gained: Math.min(raw_input.length / 10, 50) // Gamification
            })
            .select()
            .single();
        
        if (ctxError) throw ctxError;
        
        // 2. Update Proxy energy
        await supabase.rpc('increment_proxy_energy', { 
            energy_amount: Math.floor(Math.min(raw_input.length / 10, 50)) 
        });
        
        // 3. Auto-delegate to appropriate agent based on content analysis
        const delegation = await analyzeAndDelegate(raw_input, context.id, project_tag);
        
        res.json({
            status: 'success',
            context_id: context.id,
            delegation: delegation,
            message: 'Context ingested. Agents analyzing...'
        });
        
    } catch (err) {
        console.error('Feed context error:', err);
        res.status(500).json({ status: 'error', message: err.message });
    }
});

async function analyzeAndDelegate(raw_input, contextId, projectTag) {
    // Simple keyword-based routing (in production, use LLM for routing)
    const input = raw_input.toLowerCase();
    const delegations = [];
    
    // Code/deployment tasks -> Minion
    if (input.includes('code') || input.includes('deploy') || input.includes('github') || 
        input.includes('build') || input.includes('schema') || input.includes('api')) {
        
        const { data: task } = await supabase.from('agent_tasks').insert({
            context_id: contextId,
            agent_role: 'minion',
            task_description: raw_input,
            task_type: 'code',
            project_tag: projectTag,
            priority: 8
        }).select().single();
        
        delegations.push({ agent: 'minion', task_id: task.id });
    }
    
    // Research/data tasks -> Scout
    if (input.includes('research') || input.includes('find') || input.includes('scrape') || 
        input.includes('supplier') || input.includes('market') || input.includes('competitor')) {
        
        const { data: task } = await supabase.from('agent_tasks').insert({
            context_id: contextId,
            agent_role: 'scout',
            task_description: raw_input,
            task_type: 'research',
            project_tag: projectTag,
            priority: 7
        }).select().single();
        
        delegations.push({ agent: 'scout', task_id: task.id });
    }
    
    // Strategy/QA tasks -> Sage
    if (input.includes('review') || input.includes('strategy') || input.includes('qa') || 
        input.includes('polish') || input.includes('analyze') || input.includes('validate')) {
        
        const { data: task } = await supabase.from('agent_tasks').insert({
            context_id: contextId,
            agent_role: 'sage',
            task_description: raw_input,
            task_type: 'strategy',
            project_tag: projectTag,
            priority: 9
        }).select().single();
        
        delegations.push({ agent: 'sage', task_id: task.id });
    }
    
    // If no specific agent matched, default to Scout for research
    if (delegations.length === 0) {
        const { data: task } = await supabase.from('agent_tasks').insert({
            context_id: contextId,
            agent_role: 'scout',
            task_description: `Research and analyze: ${raw_input}`,
            task_type: 'research',
            project_tag: projectTag,
            priority: 5
        }).select().single();
        
        delegations.push({ agent: 'scout', task_id: task.id });
    }
    
    return delegations;
}

// Get swarm status
app.get('/api/swarm-status', async (req, res) => {
    try {
        const { data: tasks } = await supabase
            .from('agent_tasks')
            .select('*')
            .order('created_at', { ascending: false })
            .limit(20);
        
        const { data: stats } = await supabase
            .from('proxy_stats')
            .select('*')
            .single();
        
        res.json({
            agents: {
                minion: tasks.filter(t => t.agent_role === 'minion'),
                scout: tasks.filter(t => t.agent_role === 'scout'),
                sage: tasks.filter(t => t.agent_role === 'sage')
            },
            proxy_stats: stats,
            active_tasks: tasks.filter(t => t.status === 'working').length
        });
        
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Manual task assignment (override)
app.post('/api/assign-task', async (req, res) => {
    const { agent_role, task_description, project_tag, priority = 5 } = req.body;
    
    try {
        const { data: task, error } = await supabase
            .from('agent_tasks')
            .insert({
                agent_role,
                task_description,
                project_tag,
                priority,
                status: 'pending'
            })
            .select()
            .single();
        
        if (error) throw error;
        
        res.json({ status: 'success', task });
        
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Halt task
app.post('/api/halt-task/:taskId', async (req, res) => {
    const { taskId } = req.params;
    
    try {
        await supabase
            .from('agent_tasks')
            .update({ status: 'halted', updated_at: new Date().toISOString() })
            .eq('id', taskId);
        
        res.json({ status: 'success', message: 'Task halted' });
        
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Get memories
app.get('/api/memories/:agentRole', async (req, res) => {
    const { agentRole } = req.params;
    
    try {
        const { data, error } = await supabase
            .from('agent_memories')
            .select('*')
            .eq('agent_role', agentRole)
            .single();
        
        if (error) throw error;
        res.json(data);
        
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Initialize
app.listen(PORT, async () => {
    console.log(`🚀 ProxyOS Swarm listening on port ${PORT}`);
    await syncMemoriesOnBoot();
});
 

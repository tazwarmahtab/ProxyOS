Phase 1: World Generation Pipeline
1.1 AI Concept Generator (Hugging Face)
lib/world-generator/concept.ts

import { createClient } from '@supabase/supabase-js';

export interface WorldConcept {
  id: string;
  prompt: string;
  imageUrl: string;
  thumbnailUrl: string;
  seed: number;
  styleAnalysis: StyleProfile;
  generatedAt: string;
}

export interface StyleProfile {
  primaryColors: string[];
  mood: 'energetic' | 'calm' | 'mysterious' | 'corporate';
  lighting: 'neon' | 'natural' | 'moody' | 'clinical';
  complexity: 'minimal' | 'moderate' | 'dense';
  era: 'retro' | 'modern' | 'futuristic' | 'timeless';
}

const HF_API_URL = 'https://api-inference.huggingface.co/models';
const MODELS = {
  sdxl: 'stabilityai/stable-diffusion-xl-base-1.0',
  depth: 'Intel/dpt-large',
  segmentation: 'facebook/detr-resnet-50-panoptic'
};

export class WorldConceptGenerator {
  private apiKey: string;
  private rateLimiter: Map<string, number> = new Map();

  constructor(apiKey: string) {
    this.apiKey = apiKey;
  }

  async generateConcept(
    prompt: string, 
    options: {
      width?: number;
      height?: number;
      guidanceScale?: number;
      negativePrompt?: string;
    } = {}
  ): Promise<WorldConcept> {
    // Rate limiting: 30 requests/minute on free tier
    await this.enforceRateLimit();

    const seed = Math.floor(Math.random() * 2147483647);
    
    const enhancedPrompt = this.enhancePrompt(prompt);
    
    const response = await fetch(`${HF_API_URL}/${MODELS.sdxl}`, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${this.apiKey}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        inputs: enhancedPrompt,
        parameters: {
          width: options.width || 1024,
          height: options.height || 1024,
          guidance_scale: options.guidanceScale || 7.5,
          num_inference_steps: 50,
          seed: seed,
          negative_prompt: options.negativePrompt || 'blurry, low quality, distorted, people, cars, outdoor'
        }
      }),
    });

    if (!response.ok) {
      const error = await response.text();
      throw new Error(`Generation failed: ${error}`);
    }

    const blob = await response.blob();
    const arrayBuffer = await blob.arrayBuffer();
    const base64 = Buffer.from(arrayBuffer).toString('base64');
    const dataUrl = `data:image/png;base64,${base64}`;

    // Analyze style for 3D reconstruction parameters
    const styleAnalysis = await this.analyzeStyle(dataUrl);

    return {
      id: `concept-${Date.now()}`,
      prompt: enhancedPrompt,
      imageUrl: dataUrl,
      thumbnailUrl: await this.generateThumbnail(dataUrl),
      seed,
      styleAnalysis,
      generatedAt: new Date().toISOString()
    };
  }

  private enhancePrompt(userPrompt: string): string {
    const enhancers = [
      'isometric office interior',
      'architectural visualization',
      'highly detailed',
      '8k resolution',
      'professional photography',
      'volumetric lighting',
      'depth of field'
    ];

    // Detect style keywords
    const styleKeywords: Record<string, string[]> = {
      cyberpunk: ['neon lights', 'holographic displays', 'dark atmosphere', 'purple and cyan accents'],
      minimal: ['clean lines', 'white walls', 'natural wood', 'abundant natural light'],
      industrial: ['exposed brick', 'steel beams', 'concrete floors', 'warm Edison bulbs'],
      nature: ['living walls', 'bamboo furniture', 'skylights', 'earthy tones'],
      futuristic: ['floating furniture', 'glass everything', 'LED strips', 'monochrome']
    };

    const detectedStyle = Object.keys(styleKeywords).find(k => 
      userPrompt.toLowerCase().includes(k)
    ) || 'modern';

    const styleTerms = styleKeywords[detectedStyle] || styleKeywords.modern;

    return `${userPrompt}, ${enhancers.join(', ')}, ${styleTerms.join(', ')}`;
  }

  private async analyzeStyle(imageUrl: string): Promise<StyleProfile> {
    // Use color extraction and CLIP-based analysis
    // Simplified: return based on prompt analysis
    return {
      primaryColors: ['#1a1a2e', '#16213e', '#0f3460'],
      mood: 'mysterious',
      lighting: 'neon',
      complexity: 'moderate',
      era: 'futuristic'
    };
  }

  private async generateThumbnail(fullImage: string): Promise<string> {
    // Create 256x256 thumbnail
    // Implementation: canvas-based resize
    return fullImage; // Placeholder
  }

  private async enforceRateLimit(): Promise<void> {
    const now = Date.now();
    const windowStart = now - 60000; // 1 minute window
    const requestCount = Array.from(this.rateLimiter.values())
      .filter(t => t > windowStart)
      .length;

    if (requestCount >= 30) {
      const oldestRequest = Math.min(...this.rateLimiter.values());
      const waitTime = 60000 - (now - oldestRequest);
      await new Promise(r => setTimeout(r, waitTime));
    }

    this.rateLimiter.set(crypto.randomUUID(), now);
  }
}
1.2 3D Reconstruction Engine
lib/world-generator/geometry.ts

import * as THREE from 'three';
import { SimplexNoise } from 'three/examples/jsm/math/SimplexNoise';

export interface OfficeGeometry {
  id: string;
  conceptId: string;
  meshes: THREE.BufferGeometry[];
  materials: THREE.Material[];
  collisionMap: boolean[][];
  spawnPoints: Vector3[];
  lightingConfig: LightingConfig;
  agentAnchors: Map<string, Vector3>;
}

export interface LightingConfig {
  ambient: { color: string; intensity: number };
  directional: { color: string; intensity: number; position: Vector3 };
  points: Array<{ color: string; intensity: number; position: Vector3; decay: number }>;
  fog?: { color: string; near: number; far: number };
}

export interface Vector3 { x: number; y: number; z: number }

export class GeometryReconstructor {
  private noise = new SimplexNoise();

  reconstructFromConcept(concept: WorldConcept): OfficeGeometry {
    // Generate procedural office based on style analysis
    const config = this.generateLayoutConfig(concept.styleAnalysis);
    
    const geometry: OfficeGeometry = {
      id: `geo-${concept.id}`,
      conceptId: concept.id,
      meshes: [],
      materials: [],
      collisionMap: [],
      spawnPoints: [],
      lightingConfig: this.generateLighting(concept.styleAnalysis),
      agentAnchors: new Map()
    };

    // Floor plan generation using Wave Function Collapse (simplified)
    const grid = this.generateFloorPlan(config);
    
    // Convert grid to 3D meshes
    geometry.meshes = this.meshesFromGrid(grid, config);
    
    // Place agent workstations
    geometry.agentAnchors = this.placeAgentStations(grid, config);
    
    // Generate collision map for physics
    geometry.collisionMap = this.generateCollisionMap(grid);

    return geometry;
  }

  private generateLayoutConfig(style: StyleProfile): LayoutConfig {
    const configs: Record<string, LayoutConfig> = {
      minimal: {
        roomShape: 'open',
        deskCount: 3,
        plantDensity: 0.2,
        techDensity: 0.3,
        wallHeight: 2.5,
        colorPalette: ['#ffffff', '#f5f5f5', '#e0e0e0']
      },
      cyberpunk: {
        roomShape: 'irregular',
        deskCount: 3,
        plantDensity: 0.1,
        techDensity: 0.8,
        wallHeight: 4,
        colorPalette: ['#0a0a0f', '#1a0b2e', '#16213e', '#00d9ff', '#ff00ff']
      },
      industrial: {
        roomShape: 'loft',
        deskCount: 3,
        plantDensity: 0.4,
        techDensity: 0.4,
        wallHeight: 5,
        colorPalette: ['#8b4513', '#2f4f4f', '#daa520', '#cd853f']
      }
    };

    return configs[style.mood] || configs.minimal;
  }

  private generateFloorPlan(config: LayoutConfig): GridCell[][] {
    const size = 16;
    const grid: GridCell[][] = Array(size).fill(null).map(() => 
      Array(size).fill(null).map(() => ({ type: 'empty', height: 0 }))
    );

    // Generate base room shape
    const center = Math.floor(size / 2);
    const roomRadius = 6;

    for (let x = 0; x < size; x++) {
      for (let z = 0; z < size; z++) {
        const dist = Math.sqrt((x - center) ** 2 + (z - center) ** 2);
        
        if (dist < roomRadius) {
          grid[x][z] = { type: 'floor', height: 0 };
          
          // Add noise for organic feel
          const noiseVal = this.noise.noise(x * 0.1, z * 0.1);
          if (noiseVal > 0.3) {
            grid[x][z].decoration = 'rug';
          }
        }
      }
    }

    // Place desks in triangular formation (optimal for agent visibility)
    const deskPositions = [
      { x: center - 3, z: center - 2 }, // Minion: Code
      { x: center + 3, z: center - 2 }, // Scout: Research  
      { x: center, z: center + 3 }      // Sage: Strategy
    ];

    deskPositions.forEach((pos, idx) => {
      grid[pos.x][pos.z] = {
        type: 'desk',
        height: 0.8,
        agent: ['minion', 'scout', 'sage'][idx],
        facing: this.calculateFacing(pos, center)
      };
    });

    // Place Proxy command center
    grid[center][center] = {
      type: 'command',
      height: 0.1,
      agent: 'proxy'
    };

    // Add environmental details
    this.scatterProps(grid, config);

    return grid;
  }

  private meshesFromGrid(grid: GridCell[][], config: LayoutConfig): THREE.BufferGeometry[] {
    const geometries: THREE.BufferGeometry[] = [];
    const size = grid.length;

    // Floor
    const floorGeo = new THREE.PlaneGeometry(size, size);
    floorGeo.rotateX(-Math.PI / 2);
    geometries.push(floorGeo);

    // Walls (extruded from floor perimeter)
    const wallShape = new THREE.Shape();
    // ... wall generation logic
    const wallGeo = new THREE.ExtrudeGeometry(wallShape, {
      depth: config.wallHeight,
      bevelEnabled: false
    });
    geometries.push(wallGeo);

    // Furniture instances
    grid.forEach((row, x) => {
      row.forEach((cell, z) => {
        if (cell.type === 'desk') {
          const deskGeo = this.createDeskGeometry(config);
          deskGeo.translate(x - size/2, cell.height, z - size/2);
          geometries.push(deskGeo);
        }
      });
    });

    return geometries;
  }

  private createDeskGeometry(config: LayoutConfig): THREE.BufferGeometry {
    // Procedural desk based on style
    const top = new THREE.BoxGeometry(1.2, 0.05, 0.8);
    const leg1 = new THREE.BoxGeometry(0.05, 0.75, 0.05);
    leg1.translate(-0.5, -0.375, -0.3);
    const leg2 = new THREE.BoxGeometry(0.05, 0.75, 0.05);
    leg2.translate(0.5, -0.375, -0.3);
    const leg3 = new THREE.BoxGeometry(0.05, 0.75, 0.05);
    leg3.translate(-0.5, -0.375, 0.3);
    const leg4 = new THREE.BoxGeometry(0.05, 0.75, 0.05);
    leg4.translate(0.5, -0.375, 0.3);

    // Merge geometries
    return THREE.BufferGeometryUtils.mergeGeometries([
      top, leg1, leg2, leg3, leg4
    ]);
  }

  private placeAgentStations(grid: GridCell[][], config: LayoutConfig): Map<string, Vector3> {
    const anchors = new Map<string, Vector3>();
    const size = grid.length;

    grid.forEach((row, x) => {
      row.forEach((cell, z) => {
        if (cell.agent) {
          anchors.set(cell.agent, {
            x: (x - size/2) * 1.5,
            y: cell.height,
            z: (z - size/2) * 1.5
          });
        }
      });
    });

    return anchors;
  }

  private generateLighting(style: StyleProfile): LightingConfig {
    const lightingPresets: Record<string, LightingConfig> = {
      neon: {
        ambient: { color: '#1a0b2e', intensity: 0.3 },
        directional: { color: '#4a5568', intensity: 0.5, position: { x: 10, y: 20, z: 10 } },
        points: [
          { color: '#00d9ff', intensity: 2, position: { x: -3, y: 3, z: -2 }, decay: 2 },
          { color: '#ff00ff', intensity: 2, position: { x: 3, y: 3, z: -2 }, decay: 2 },
          { color: '#00ff88', intensity: 1.5, position: { x: 0, y: 4, z: 3 }, decay: 2 }
        ],
        fog: { color: '#0a0a0f', near: 10, far: 30 }
      },
      natural: {
        ambient: { color: '#ffffff', intensity: 0.6 },
        directional: { color: '#fff7ed', intensity: 1.2, position: { x: 5, y: 10, z: 5 } },
        points: [],
        fog: { color: '#f5f5f5', near: 20, far: 50 }
      }
    };

    return lightingPresets[style.lighting] || lightingPresets.natural;
  }
}
 
Phase 2: Interactive 3D Engine
2.1 Isometric World Renderer
components/world/IsometricOffice.tsx

'use client';

import { useEffect, useRef, useCallback, useState } from 'react';
import * as THREE from 'three';
import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls';
import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer';
import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass';
import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass';
import { useAgentStore } from '@/stores/agentStore';
import { useTaskStore } from '@/stores/taskStore';
import { AgentAvatar } from './AgentAvatar';
import { ParticleSystem } from './ParticleSystem';
import { SpatialAudio } from './SpatialAudio';

interface IsometricOfficeProps {
  geometry: OfficeGeometry;
  conceptImage: string;
  onAgentClick?: (agentId: string) => void;
  onObjectInteract?: (objectType: string, position: Vector3) => void;
}

export function IsometricOffice({ 
  geometry, 
  conceptImage,
  onAgentClick,
  onObjectInteract 
}: IsometricOfficeProps) {
  const containerRef = useRef<HTMLDivElement>(null);
  const sceneRef = useRef<THREE.Scene>();
  const rendererRef = useRef<THREE.WebGLRenderer>();
  const composerRef = useRef<EffectComposer>();
  const controlsRef = useRef<OrbitControls>();
  const frameIdRef = useRef<number>();
  const raycasterRef = useRef<THREE.Raycaster>();
  const mouseRef = useRef<THREE.Vector2>();
  
  const agents = useAgentStore(state => state.agents);
  const tasks = useTaskStore(state => state.activeTasks);
  
  const [hoveredObject, setHoveredObject] = useState<string | null>(null);
  const [isLoading, setIsLoading] = useState(true);

  // Initialize scene
  useEffect(() => {
    if (!containerRef.current) return;

    const init = async () => {
      // Scene setup
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x050505);
      sceneRef.current = scene;

      // Camera: Isometric perspective
      const aspect = containerRef.current.clientWidth / containerRef.current.clientHeight;
      const d = 10;
      const camera = new THREE.OrthographicCamera(-d * aspect, d * aspect, d, -d, 1, 1000);
      camera.position.set(20, 20, 20);
      camera.lookAt(0, 0, 0);
      camera.zoom = 1.2;

      // Renderer with anti-aliasing and transparency
      const renderer = new THREE.WebGLRenderer({
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance'
      });
      renderer.setSize(containerRef.current.clientWidth, containerRef.current.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.2;
      containerRef.current.appendChild(renderer.domElement);
      rendererRef.current = renderer;

      // Post-processing for bloom effects
      const composer = new EffectComposer(renderer);
      const renderPass = new RenderPass(scene, camera);
      composer.addPass(renderPass);

      const bloomPass = new UnrealBloomPass(
        new THREE.Vector2(containerRef.current.clientWidth, containerRef.current.clientHeight),
        0.5, // strength
        0.4, // radius
        0.85 // threshold
      );
      composer.addPass(bloomPass);
      composerRef.current = composer;

      // Controls
      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.05;
      controls.minZoom = 0.5;
      controls.maxZoom = 3;
      controls.maxPolarAngle = Math.PI / 2.2; // Prevent going below ground
      controlsRef.current = controls;

      // Raycaster for interaction
      raycasterRef.current = new THREE.Raycaster();
      mouseRef.current = new THREE.Vector2();

      // Build world from geometry
      await buildWorld(scene, geometry, conceptImage);

      // Add agent avatars
      geometry.agentAnchors.forEach((position, agentId) => {
        const avatar = new AgentAvatar(agentId, position, agents[agentId]);
        scene.add(avatar.mesh);
      });

      // Particle system for task effects
      const particles = new ParticleSystem(scene);
      scene.add(particles.mesh);

      // Spatial audio
      const audio = new SpatialAudio(camera);
      scene.add(audio.listener);

      setIsLoading(false);

      // Animation loop
      const animate = () => {
        frameIdRef.current = requestAnimationFrame(animate);
        
        controls.update();
        
        // Update agents
        agents.forEach((agent, id) => {
          const avatar = scene.getObjectByName(`agent-${id}`) as AgentAvatar;
          if (avatar) avatar.update(agent, tasks);
        });

        // Update particles
        particles.update();

        composer.render();
      };
      animate();

      // Event listeners
      window.addEventListener('resize', handleResize);
      renderer.domElement.addEventListener('mousemove', handleMouseMove);
      renderer.domElement.addEventListener('click', handleClick);
      renderer.domElement.addEventListener('dblclick', handleDoubleClick);
    };

    init();

    return () => {
      if (frameIdRef.current) cancelAnimationFrame(frameIdRef.current);
      window.removeEventListener('resize', handleResize);
      rendererRef.current?.domElement.removeEventListener('mousemove', handleMouseMove);
      rendererRef.current?.domElement.removeEventListener('click', handleClick);
      rendererRef.current?.domElement.removeEventListener('dblclick', handleDoubleClick);
      rendererRef.current?.dispose();
    };
  }, [geometry, conceptImage]);

  const buildWorld = async (
    scene: THREE.Scene, 
    geometry: OfficeGeometry,
    conceptImage: string
  ) => {
    // Apply lighting config
    const light = geometry.lightingConfig;
    
    const ambient = new THREE.AmbientLight(light.ambient.color, light.ambient.intensity);
    scene.add(ambient);

    const dirLight = new THREE.DirectionalLight(light.directional.color, light.directional.intensity);
    dirLight.position.set(
      light.directional.position.x,
      light.directional.position.y,
      light.directional.position.z
    );
    dirLight.castShadow = true;
    dirLight.shadow.mapSize.width = 2048;
    dirLight.shadow.mapSize.height = 2048;
    scene.add(dirLight);

    light.points.forEach(point => {
      const pl = new THREE.PointLight(point.color, point.intensity, 10, point.decay);
      pl.position.set(point.position.x, point.position.y, point.position.z);
      scene.add(pl);
      
      // Glow sprite
      const spriteMaterial = new THREE.SpriteMaterial({
        map: createGlowTexture(),
        color: point.color,
        transparent: true,
        blending: THREE.AdditiveBlending
      });
      const sprite = new THREE.Sprite(spriteMaterial);
      sprite.scale.set(0.5, 0.5, 0.5);
      sprite.position.copy(pl.position);
      scene.add(sprite);
    });

    if (light.fog) {
      scene.fog = new THREE.Fog(light.fog.color, light.fog.near, light.fog.far);
    }

    // Build meshes
    geometry.meshes.forEach((geo, idx) => {
      const material = new THREE.MeshStandardMaterial({
        color: geometry.materials[idx] || 0x888888,
        roughness: 0.7,
        metalness: 0.1
      });
      const mesh = new THREE.Mesh(geo, material);
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      mesh.userData = { type: 'environment', id: idx };
      scene.add(mesh);
    });

    // Concept image as environment map (reflections)
    const textureLoader = new THREE.TextureLoader();
    const envTexture = await new Promise<THREE.Texture>((resolve) => {
      textureLoader.load(conceptImage, (tex) => {
        tex.mapping = THREE.EquirectangularReflectionMapping;
        resolve(tex);
      });
    });
    scene.environment = envTexture;
  };

  const handleResize = () => {
    if (!containerRef.current || !rendererRef.current || !composerRef.current) return;
    
    const width = containerRef.current.clientWidth;
    const height = containerRef.current.clientHeight;
    
    const camera = sceneRef.current?.camera as THREE.OrthographicCamera;
    if (camera) {
      const aspect = width / height;
      camera.left = -10 * aspect;
      camera.right = 10 * aspect;
      camera.updateProjectionMatrix();
    }
    
    rendererRef.current.setSize(width, height);
    composerRef.current.setSize(width, height);
  };

  const handleMouseMove = (event: MouseEvent) => {
    if (!containerRef.current || !raycasterRef.current || !mouseRef.current) return;
    
    const rect = containerRef.current.getBoundingClientRect();
    mouseRef.current.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
    mouseRef.current.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

    raycasterRef.current.setFromCamera(mouseRef.current, sceneRef.current!.camera);
    const intersects = raycasterRef.current.intersectObjects(sceneRef.current!.children, true);

    if (intersects.length > 0) {
      const object = intersects[0].object;
      if (object.userData.type === 'agent') {
        setHoveredObject(object.userData.agentId);
        document.body.style.cursor = 'pointer';
      } else if (object.userData.type === 'environment') {
        setHoveredObject(`object-${object.userData.id}`);
        document.body.style.cursor = 'help';
      }
    } else {
      setHoveredObject(null);
      document.body.style.cursor = 'default';
    }
  };

  const handleClick = (event: MouseEvent) => {
    if (!raycasterRef.current || !mouseRef.current) return;
    
    raycasterRef.current.setFromCamera(mouseRef.current, sceneRef.current!.camera);
    const intersects = raycasterRef.current.intersectObjects(sceneRef.current!.children, true);

    if (intersects.length > 0) {
      const object = intersects[0].object;
      
      if (object.userData.type === 'agent') {
        onAgentClick?.(object.userData.agentId);
        
        // Visual feedback
        const originalScale = object.scale.clone();
        object.scale.multiplyScalar(1.2);
        setTimeout(() => {
          object.scale.copy(originalScale);
        }, 200);
      } else {
        onObjectInteract?.(object.userData.type, {
          x: intersects[0].point.x,
          y: intersects[0].point.y,
          z: intersects[0].point.z
        });
      }
    }
  };

  const handleDoubleClick = () => {
    // Reset camera
    controlsRef.current?.reset();
  };

  return (
    <div className="relative w-full h-full">
      <div 
        ref={containerRef} 
        className="w-full h-full rounded-2xl overflow-hidden border border-white/10 bg-black"
      />
      
      {isLoading && (
        <div className="absolute inset-0 flex items-center justify-center bg-black/80 backdrop-blur-sm">
          <div className="flex flex-col items-center gap-4">
            <div className="w-12 h-12 border-2 border-blue-500/30 border-t-blue-500 rounded-full animate-spin" />
            <p className="text-white/60 text-sm tracking-wide">Constructing World...</p>
          </div>
        </div>
      )}

      {hoveredObject && (
        <div className="absolute top-4 left-4 px-3 py-1.5 bg-black/60 backdrop-blur-md border border-white/10 rounded-full">
          <p className="text-xs text-white/80 font-medium">
            {hoveredObject.startsWith('agent-') 
              ? `Agent: ${hoveredObject.replace('agent-', '')}` 
              : 'Interactive Object'}
          </p>
        </div>
      )}
    </div>
  );
}

function createGlowTexture(): THREE.Texture {
  const canvas = document.createElement('canvas');
  canvas.width = 64;
  canvas.height = 64;
  const context = canvas.getContext('2d')!;
  
  const gradient = context.createRadialGradient(32, 32, 0, 32, 32, 32);
  gradient.addColorStop(0, 'rgba(255,255,255,1)');
  gradient.addColorStop(0.2, 'rgba(255,255,255,0.5)');
  gradient.addColorStop(0.5, 'rgba(255,255,255,0.1)');
  gradient.addColorStop(1, 'rgba(0,0,0,0)');
  
  context.fillStyle = gradient;
  context.fillRect(0, 0, 64, 64);
  
  const texture = new THREE.CanvasTexture(canvas);
  return texture;
}
2.2 Agent Avatar System
components/world/AgentAvatar.ts

import * as THREE from 'three';
import { AgentState } from '@/stores/agentStore';
import { Task } from '@/stores/taskStore';

export class AgentAvatar {
  public mesh: THREE.Group;
  private agentId: string;
  private basePosition: THREE.Vector3;
  private state: 'idle' | 'working' | 'success' | 'error' = 'idle';
  private animationMixer?: THREE.AnimationMixer;
  private particles: THREE.Points;
  private hologram: THREE.Mesh;
  private statusRing: THREE.Mesh;

  constructor(agentId: string, position: Vector3, initialState: AgentState) {
    this.agentId = agentId;
    this.basePosition = new THREE.Vector3(position.x, position.y, position.z);
    
    this.mesh = new THREE.Group();
    this.mesh.name = `agent-${agentId}`;
    this.mesh.userData = { type: 'agent', agentId };
    this.mesh.position.copy(this.basePosition);

    this.buildAvatar();
    this.buildHologram();
    this.buildStatusRing();
    this.buildParticles();
  }

  private buildAvatar() {
    // Agent body (pixel-art style voxel)
    const colors: Record<string, number> = {
      minion: 0x10b981,  // Emerald
      scout: 0x3b82f6,   // Blue
      sage: 0xa855f7,    // Purple
      proxy: 0xf59e0b    // Amber
    };

    const color = colors[this.agentId] || 0xffffff;

    // Main body
    const bodyGeo = new THREE.BoxGeometry(0.4, 0.6, 0.3);
    const bodyMat = new THREE.MeshStandardMaterial({ 
      color,
      roughness: 0.3,
      metalness: 0.7,
      emissive: color,
      emissiveIntensity: 0.2
    });
    const body = new THREE.Mesh(bodyGeo, bodyMat);
    body.position.y = 0.3;
    body.castShadow = true;
    this.mesh.add(body);

    // Head
    const headGeo = new THREE.BoxGeometry(0.3, 0.3, 0.3);
    const headMat = new THREE.MeshStandardMaterial({ 
      color: 0xffdbac,
      roughness: 0.8 
    });
    const head = new THREE.Mesh(headGeo, headMat);
    head.position.y = 0.75;
    this.mesh.add(head);

    // Eyes (glowing)
    const eyeGeo = new THREE.PlaneGeometry(0.08, 0.08);
    const eyeMat = new THREE.MeshBasicMaterial({ 
      color: 0x00ffff,
      side: THREE.DoubleSide
    });
    const leftEye = new THREE.Mesh(eyeGeo, eyeMat);
    leftEye.position.set(-0.08, 0.75, 0.16);
    const rightEye = new THREE.Mesh(eyeGeo, eyeMat);
    rightEye.position.set(0.08, 0.75, 0.16);
    this.mesh.add(leftEye, rightEye);

    // Floating animation
    const floatTween = { y: 0 };
    const animate = () => {
      requestAnimationFrame(animate);
      floatTween.y = Math.sin(Date.now() * 0.002) * 0.05;
      this.mesh.position.y = this.basePosition.y + floatTween.y;
    };
    animate();
  }

  private buildHologram() {
    // Holographic display above agent
    const geo = new THREE.CylinderGeometry(0.3, 0.3, 0.01, 32, 1, true);
    const mat = new THREE.MeshBasicMaterial({
      color: 0x00d9ff,
      transparent: true,
      opacity: 0.3,
      side: THREE.DoubleSide,
      blending: THREE.AdditiveBlending
    });
    this.hologram = new THREE.Mesh(geo, mat);
    this.hologram.position.y = 1.2;
    this.mesh.add(this.hologram);

    // Rotating rings
    const ringGeo = new THREE.TorusGeometry(0.25, 0.02, 8, 32);
    const ringMat = new THREE.MeshBasicMaterial({ 
      color: 0x00d9ff,
      transparent: true,
      opacity: 0.5
    });
    const ring = new THREE.Mesh(ringGeo, ringMat);
    ring.rotation.x = Math.PI / 2;
    ring.position.y = 1.2;
    
    const animateRing = () => {
      requestAnimationFrame(animateRing);
      ring.rotation.z += 0.02;
    };
    animateRing();
    
    this.mesh.add(ring);
  }

  private buildStatusRing() {
    const geo = new THREE.RingGeometry(0.35, 0.4, 32);
    const mat = new THREE.MeshBasicMaterial({ 
      color: 0x10b981,
      transparent: true,
      opacity: 0.8,
      side: THREE.DoubleSide
    });
    this.statusRing = new THREE.Mesh(geo, mat);
    this.statusRing.rotation.x = -Math.PI / 2;
    this.statusRing.position.y = 0.05;
    this.mesh.add(this.statusRing);
  }

  private buildParticles() {
    const particleCount = 20;
    const geo = new THREE.BufferGeometry();
    const positions = new Float32Array(particleCount * 3);
    const colors = new Float32Array(particleCount * 3);

    for (let i = 0; i < particleCount; i++) {
      positions[i * 3] = (Math.random() - 0.5) * 0.5;
      positions[i * 3 + 1] = Math.random() * 0.5;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 0.5;
      
      colors[i * 3] = 0;
      colors[i * 3 + 1] = 0.8;
      colors[i * 3 + 2] = 1;
    }

    geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const mat = new THREE.PointsMaterial({
      size: 0.05,
      vertexColors: true,
      transparent: true,
      opacity: 0.6,
      blending: THREE.AdditiveBlending
    });

    this.particles = new THREE.Points(geo, mat);
    this.particles.visible = false;
    this.mesh.add(this.particles);
  }

  update(agentState: AgentState, tasks: Task[]) {
    const agentTask = tasks.find(t => t.agent_role === this.agentId && t.status === 'working');
    
    if (agentTask) {
      this.setState('working');
    } else if (tasks.some(t => t.agent_role === this.agentId && t.status === 'success')) {
      this.setState('success');
    } else {
      this.setState('idle');
    }

    // Update hologram content based on task
    if (agentTask) {
      this.updateHologramDisplay(agentTask.task_type);
    }
  }

  setState(newState: 'idle' | 'working' | 'success' | 'error') {
    if (this.state === newState) return;
    this.state = newState;

    const colors = {
      idle: 0x10b981,
      working: 0x3b82f6,
      success: 0x10b981,
      error: 0xef4444
    };

    (this.statusRing.material as THREE.MeshBasicMaterial).color.setHex(colors[newState]);

    switch (newState) {
      case 'working':
        this.particles.visible = true;
        this.animateParticles();
        break;
      case 'success':
        this.playSuccessAnimation();
        this.particles.visible = false;
        break;
      case 'error':
        this.playErrorAnimation();
        this.particles.visible = false;
        break;
      default:
        this.particles.visible = false;
    }
  }

  private animateParticles() {
    const positions = this.particles.geometry.attributes.position.array as Float32Array;
    
    for (let i = 0; i < positions.length / 3; i++) {
      positions[i * 3 + 1] += 0.01;
      if (positions[i * 3 + 1] > 0.5) {
        positions[i * 3 + 1] = 0;
      }
    }
    
    this.particles.geometry.attributes.position.needsUpdate = true;
  }

  private updateHologramDisplay(taskType: string) {
    // Change hologram color based on task
    const colors: Record<string, number> = {
      code: 0x10b981,
      research: 0x3b82f6,
      strategy: 0xa855f7
    };
    
    (this.hologram.material as THREE.MeshBasicMaterial).color.setHex(
      colors[taskType] || 0x00d9ff
    );
  }

  private playSuccessAnimation() {
    // Scale bounce
    const startScale = this.mesh.scale.clone();
    let progress = 0;
    
    const animate = () => {
      progress += 0.1;
      const scale = 1 + Math.sin(progress) * 0.2;
      this.mesh.scale.setScalar(scale);
      
      if (progress < Math.PI) {
        requestAnimationFrame(animate);
      } else {
        this.mesh.scale.copy(startScale);
      }
    };
    animate();

    // Green flash
    const flash = new THREE.PointLight(0x10b981, 2, 5);
    flash.position.copy(this.mesh.position);
    flash.position.y += 1;
    this.mesh.parent?.add(flash);
    
    setTimeout(() => {
      this.mesh.parent?.remove(flash);
    }, 500);
  }

  private playErrorAnimation() {
    // Red shake
    const startX = this.mesh.position.x;
    let shakes = 0;
    
    const shake = () => {
      shakes++;
      this.mesh.position.x = startX + (Math.random() - 0.5) * 0.1;
      
      if (shakes < 10) {
        requestAnimationFrame(shake);
      } else {
        this.mesh.position.x = startX;
      }
    };
    shake();
  }
}
 
Phase 3: Integration & UI
3.1 World Generation Interface
app/world-generator/page.tsx

'use client';

import { useState, useCallback } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { 
  Wand2, Loader2, Sparkles, Download, 
  RotateCcw, Check, AlertCircle, Image as ImageIcon 
} from 'lucide-react';
import { WorldConceptGenerator } from '@/lib/world-generator/concept';
import { GeometryReconstructor } from '@/lib/world-generator/geometry';
import { IsometricOffice } from '@/components/world/IsometricOffice';
import { useSupabase } from '@/hooks/useSupabase';

const generator = new WorldConceptGenerator(process.env.NEXT_PUBLIC_HF_TOKEN!);
const reconstructor = new GeometryReconstructor();

export default function WorldGeneratorPage() {
  const [prompt, setPrompt] = useState('');
  const [isGenerating, setIsGenerating] = useState(false);
  const [generatedWorlds, setGeneratedWorlds] = useState<WorldConcept[]>([]);
  const [selectedWorld, setSelectedWorld] = useState<WorldConcept | null>(null);
  const [geometry, setGeometry] = useState<OfficeGeometry | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [activeTab, setActiveTab] = useState<'generate' | 'gallery'>('generate');

  const handleGenerate = useCallback(async () => {
    if (!prompt.trim()) return;
    
    setIsGenerating(true);
    setError(null);

    try {
      const concept = await generator.generateConcept(prompt, {
        width: 1024,
        height: 1024,
        guidanceScale: 7.5
      });

      setGeneratedWorlds(prev => [concept, ...prev]);
      setSelectedWorld(concept);
      
      // Auto-reconstruct 3D
      const geo = reconstructor.reconstructFromConcept(concept);
      setGeometry(geo);

      // Save to Supabase
      await saveWorldToDatabase(concept, geo);

    } catch (err) {
      setError(err instanceof Error ? err.message : 'Generation failed');
    } finally {
      setIsGenerating(false);
    }
  }, [prompt]);

  const saveWorldToDatabase = async (concept: WorldConcept, geo: OfficeGeometry) => {
    const supabase = useSupabase();
    
    await supabase.from('generated_worlds').insert({
      id: concept.id,
      prompt: concept.prompt,
      image_url: concept.imageUrl,
      style_analysis: concept.styleAnalysis,
      geometry_config: geo,
      created_at: new Date().toISOString()
    });
  };

  const handleSelectWorld = (world: WorldConcept) => {
    setSelectedWorld(world);
    const geo = reconstructor.reconstructFromConcept(world);
    setGeometry(geo);
  };

  return (
    <div className="min-h-screen bg-[#050505] text-white">
      {/* Header */}
      <header className="border-b border-white/5 bg-black/20 backdrop-blur-xl sticky top-0 z-50">
        <div className="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center">
              <Sparkles className="w-5 h-5 text-white" />
            </div>
            <div>
              <h1 className="text-lg font-semibold tracking-tight">World Engine</h1>
              <p className="text-xs text-white/40">AI-Powered Office Generation</p>
            </div>
          </div>
          
          <div className="flex items-center gap-2 bg-white/5 rounded-lg p-1">
            <button
              onClick={() => setActiveTab('generate')}
              className={`px-4 py-2 rounded-md text-sm font-medium transition-all ${
                activeTab === 'generate' 
                  ? 'bg-white/10 text-white' 
                  : 'text-white/50 hover:text-white'
              }`}

            >

              Generate
            </button>
            <button
              onClick={() => setActiveTab('gallery')}
              className={`px-4 py-2 rounded-md text-sm font-medium transition-all ${
                activeTab === 'gallery' 
                  ? 'bg-white/10 text-white' 
                  : 'text-white/50 hover:text-white'
              }`}

            >

              Gallery
            </button>
          </div>
        </div>
      </header>

      <main className="max-w-7xl mx-auto px-6 py-8">
        <AnimatePresence mode="wait">
          {activeTab === 'generate' ? (
            <motion.div
              key="generate"
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0, y: -20 }}
              className="space-y-8"

            >

              {/* Prompt Input */}
              <div className="max-w-3xl mx-auto">
                <div className="relative group">
                  <div className="absolute -inset-1 bg-gradient-to-r from-blue-500 to-purple-600 rounded-2xl blur opacity-25 group-hover:opacity-50 transition-opacity" />
                  <div className="relative flex items-center gap-4 p-2 bg-black/60 backdrop-blur-2xl border border-white/10 rounded-2xl">
                    <Wand2 className="w-6 h-6 text-blue-400 ml-3" />
                    <input
                      type="text"
                      value={prompt}
                      onChange={(e) => setPrompt(e.target.value)}
                      placeholder="Describe your dream office... (e.g., 'Cyberpunk loft with neon lights, floating holograms, and glass walls')"
                      className="flex-1 bg-transparent border-none text-lg text-white placeholder:text-white/30 focus:outline-none py-3"
                      onKeyDown={(e) => e.key === 'Enter' && handleGenerate()}
                    />
                    <button
                      onClick={handleGenerate}
                      disabled={isGenerating || !prompt.trim()}
                      className="px-6 py-3 bg-blue-500 hover:bg-blue-400 disabled:bg-white/10 disabled:text-white/40 text-white rounded-xl font-medium transition-all flex items-center gap-2"

                    >

                      {isGenerating ? (
                        <>
                          <Loader2 className="w-4 h-4 animate-spin" />
                          Generating...
                        </>
                      ) : (
                        <>
                          <Sparkles className="w-4 h-4" />
                          Generate
                        </>
                      )}
                    </button>
                  </div>
                </div>

                {error && (
                  <motion.div
                    initial={{ opacity: 0, y: 10 }}
                    animate={{ opacity: 1, y: 0 }}
                    className="mt-4 p-4 bg-red-500/10 border border-red-500/20 rounded-xl flex items-center gap-3 text-red-400"

                  >

                    <AlertCircle className="w-5 h-5" />
                    <p>{error}</p>
                  </motion.div>
                )}

                {/* Quick Prompts */}
                <div className="mt-6 flex flex-wrap gap-2 justify-center">
                  {[
                    'Cyberpunk neon loft',
                    'Minimal Scandinavian',
                    'Industrial warehouse',
                    'Biophilic nature hub',
                    'Retro 80s arcade'
                  ].map((suggestion) => (
                    <button
                      key={suggestion}
                      onClick={() => setPrompt(suggestion)}
                      className="px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-full text-sm text-white/70 hover:text-white transition-all"

                    >

                      {suggestion}
                    </button>
                  ))}
                </div>
              </div>

              {/* Results */}
              {selectedWorld && geometry && (
                <motion.div
                  initial={{ opacity: 0, scale: 0.95 }}
                  animate={{ opacity: 1, scale: 1 }}
                  className="grid grid-cols-1 lg:grid-cols-2 gap-8"

                >

                  {/* 3D Preview */}
                  <div className="space-y-4">
                    <div className="flex items-center justify-between">
                      <h2 className="text-xl font-semibold">Interactive 3D Office</h2>
                      <div className="flex gap-2">
                        <button className="p-2 text-white/60 hover:text-white hover:bg-white/10 rounded-lg transition-all">
                          <RotateCcw className="w-4 h-4" />
                        </button>
                        <button className="px-4 py-2 bg-white text-black rounded-lg font-medium hover:bg-white/90 transition-all flex items-center gap-2">
                          <Check className="w-4 h-4" />
                          Use This Office
                        </button>
                      </div>
                    </div>
                    <div className="h-[500px] rounded-2xl overflow-hidden border border-white/10 bg-black">
                      <IsometricOffice
                        geometry={geometry}
                        conceptImage={selectedWorld.imageUrl}
                        onAgentClick={(id) => console.log('Clicked agent:', id)}
                        onObjectInteract={(type, pos) => console.log('Interacted:', type, pos)}
                      />
                    </div>
                  </div>

                  {/* Concept Art & Details */}
                  <div className="space-y-4">
                    <h2 className="text-xl font-semibold">Concept Art</h2>
                    <div className="relative aspect-square rounded-2xl overflow-hidden border border-white/10">
                      <img
                        src={selectedWorld.imageUrl}
                        alt="Generated office concept"
                        className="w-full h-full object-cover"
                      />
                      <div className="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent" />
                      <div className="absolute bottom-4 left-4 right-4">
                        <div className="flex flex-wrap gap-2">
                          {Object.entries(selectedWorld.styleAnalysis).map(([key, value]) => (
                            <span
                              key={key}
                              className="px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-xs text-white/80"

                            >

                              {key}: {value}
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>

                    {/* Generation Details */}
                    <div className="p-4 bg-white/5 border border-white/10 rounded-xl space-y-3">
                      <div className="flex justify-between text-sm">
                        <span className="text-white/50">Seed</span>
                        <span className="font-mono text-white/80">{selectedWorld.seed}</span>
                      </div>
                      <div className="flex justify-between text-sm">
                        <span className="text-white/50">Generated</span>
                        <span className="text-white/80">
                          {new Date(selectedWorld.generatedAt).toLocaleString()}
                        </span>
                      </div>
                      <div className="flex justify-between text-sm">
                        <span className="text-white/50">Resolution</span>
                        <span className="text-white/80">1024 × 1024</span>
                      </div>
                    </div>
                  </div>
                </motion.div>
              )}
            </motion.div>
          ) : (
            <motion.div
              key="gallery"
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0, y: -20 }}
              className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"

            >

              {generatedWorlds.map((world) => (
                <motion.div
                  key={world.id}
                  layout
                  onClick={() => handleSelectWorld(world)}
                  className="group relative aspect-square rounded-2xl overflow-hidden border border-white/10 cursor-pointer hover:border-white/30 transition-all"

                >

                  <img
                    src={world.imageUrl}
                    alt={world.prompt}
                    className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <div className="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity">
                    <div className="absolute bottom-0 left-0 right-0 p-4">
                      <p className="text-sm text-white line-clamp-2 mb-2">{world.prompt}</p>
                      <div className="flex items-center gap-2">
                        <span className="px-2 py-1 bg-blue-500/20 text-blue-400 rounded text-xs">
                          {world.styleAnalysis.mood}
                        </span>
                        <span className="px-2 py-1 bg-purple-500/20 text-purple-400 rounded text-xs">
                          {world.styleAnalysis.lighting}
                        </span>
                      </div>
                    </div>
                  </div>
                </motion.div>
              ))}
            </motion.div>
          )}
        </AnimatePresence>
      </main>
    </div>
  );
}
 
Phase 4: Deployment & Integration
4.1 Environment Variables
.env.local

# Supabase

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# Hugging Face (Free tier: 30k requests/month)

NEXT_PUBLIC_HF_TOKEN=your_huggingface_token

# Backend (Hugging Face Space)

NEXT_PUBLIC_BACKEND_URL=https://your-username-proxyos-backend.hf.space

# Optional: Replicate for higher quality (paid)

REPLICATE_API_TOKEN=your_replicate_token
4.2 Database Schema (Supabase)

-- Generated worlds storage

CREATE TABLE generated_worlds (
    id TEXT PRIMARY KEY,
    prompt TEXT NOT NULL,
    image_url TEXT NOT NULL,
    thumbnail_url TEXT,
    style_analysis JSONB NOT NULL,
    geometry_config JSONB NOT NULL,
    seed INTEGER,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    user_id UUID REFERENCES auth.users(id),
    is_favorite BOOLEAN DEFAULT FALSE,
    usage_count INTEGER DEFAULT 0
);

-- Active office instances

CREATE TABLE office_instances (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    world_id TEXT REFERENCES generated_worlds(id),
    user_id UUID REFERENCES auth.users(id),
    agent_positions JSONB DEFAULT '{}',
    active_tasks UUID[],
    created_at TIMESTAMPTZ DEFAULT NOW(),
    last_active TIMESTAMPTZ DEFAULT NOW()
);

-- Enable RLS

ALTER TABLE generated_worlds ENABLE ROW LEVEL SECURITY;
ALTER TABLE office_instances ENABLE ROW LEVEL SECURITY;

-- Policies

CREATE POLICY "Users can view their own worlds"
    ON generated_worlds FOR SELECT
    USING (user_id = auth.uid() OR user_id IS NULL);

CREATE POLICY "Users can insert their own worlds"
    ON generated_worlds FOR INSERT
    WITH CHECK (user_id = auth.uid());
 

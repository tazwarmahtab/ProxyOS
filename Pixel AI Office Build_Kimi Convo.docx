Production-Ready Implementation
1. Bulletproof Backend
server-production.js

const express = require('express');
const cors = require('cors');
const helmet = require('helmet');
const rateLimit = require('express-rate-limit');
const { createClient } = require('@supabase/supabase-js');
const { Groq } = require('groq-sdk');
const { GoogleGenerativeAI } = require('@google/generative-ai');
const { Temporal } = require('@temporalio/client');
const winston = require('winston');
const Joi = require('joi');
const NodeCache = require('node-cache');

// Structured logging
const logger = winston.createLogger({
  level: 'info',
  format: winston.format.combine(
    winston.format.timestamp(),
    winston.format.json()
  ),
  transports: [
    new winston.transports.Console(),
    new winston.transports.File({ filename: 'error.log', level: 'error' })
  ]
});

// Validation schemas
const contextSchema = Joi.object({
  raw_input: Joi.string().max(10000).required(),
  input_type: Joi.string().valid('text', 'voice', 'link', 'file').default('text'),
  project_tag: Joi.string().max(50).alphanum(),
  metadata: Joi.object().default({})
});

const app = express();

// Security middleware
app.use(helmet());
app.use(cors({ origin: process.env.ALLOWED_ORIGINS?.split(',') || '*' }));
app.use(express.json({ limit: '10mb' }));

// Rate limiting with Redis store (Upstash)
const limiter = rateLimit({
  windowMs: 1 * 60 * 1000, // 1 minute
  max: 30,
  standardHeaders: true,
  legacyHeaders: false,
  keyGenerator: (req) => req.ip,
  handler: (req, res) => {
    logger.warn('Rate limit exceeded', { ip: req.ip });
    res.status(429).json({ error: 'Too many requests', retryAfter: 60 });
  }
});
app.use('/api/', limiter);

// Circuit breaker pattern
class CircuitBreaker {
  constructor(threshold = 5, timeout = 60000) {
    this.failures = 0;
    this.threshold = threshold;
    this.timeout = timeout;
    this.state = 'CLOSED'; // CLOSED, OPEN, HALF_OPEN
    this.nextAttempt = Date.now();
  }

  async execute(fn) {
    if (this.state === 'OPEN') {
      if (Date.now() < this.nextAttempt) {
        throw new Error('Circuit breaker is OPEN');
      }
      this.state = 'HALF_OPEN';
    }

    try {
      const result = await fn();
      this.onSuccess();
      return result;
    } catch (error) {
      this.onFailure();
      throw error;
    }
  }

  onSuccess() {
    this.failures = 0;
    this.state = 'CLOSED';
  }

  onFailure() {
    this.failures += 1;
    if (this.failures >= this.threshold) {
      this.state = 'OPEN';
      this.nextAttempt = Date.now() + this.timeout;
      logger.error('Circuit breaker opened');
    }
  }
}

const groqBreaker = new CircuitBreaker();
const geminiBreaker = new CircuitBreaker();

// LLM Router with fallback
async function routeWithFallback(prompt, context, taskType) {
  const providers = [
    { name: 'groq', breaker: groqBreaker, fn: () => callGroq(prompt, context) },
    { name: 'gemini', breaker: geminiBreaker, fn: () => callGemini(prompt, context) }
  ];

  for (const provider of providers) {
    try {
      return await provider.breaker.execute(provider.fn);
    } catch (err) {
      logger.warn(`${provider.name} failed, trying next`, { error: err.message });
      continue;
    }
  }

  throw new Error('All LLM providers failed');
}

// Distributed lane lock using Supabase
async function acquireLane(agentRole, taskId, timeoutMs = 300000) {
  const expiresAt = new Date(Date.now() + timeoutMs).toISOString();
  
  const { data, error } = await supabase
    .from('agent_locks')
    .upsert({
      agent_role: agentRole,
      task_id: taskId,
      acquired_at: new Date().toISOString(),
      expires_at: expiresAt,
      instance_id: process.env.INSTANCE_ID || 'default'
    }, { onConflict: 'agent_role' })
    .select();

  if (error) {
    // Check if existing lock is expired
    const { data: existing } = await supabase
      .from('agent_locks')
      .select('*')
      .eq('agent_role', agentRole)
      .single();
    
    if (existing && new Date(existing.expires_at) < new Date()) {
      // Steal expired lock
      await supabase.from('agent_locks').delete().eq('agent_role', agentRole);
      return acquireLane(agentRole, taskId, timeoutMs);
    }
    
    return false;
  }

  // Heartbeat
  const heartbeat = setInterval(async () => {
    const { error: hbError } = await supabase
      .from('agent_locks')
      .update({ expires_at: new Date(Date.now() + timeoutMs).toISOString() })
      .eq('agent_role', agentRole)
      .eq('task_id', taskId);
    
    if (hbError) {
      clearInterval(heartbeat);
    }
  }, 30000);

  return { release: () => {
    clearInterval(heartbeat);
    return supabase.from('agent_locks').delete().eq('agent_role', agentRole);
  }};
}

// Temporal workflow for complex tasks
async function startAgentWorkflow(taskId, agentRole, context) {
  const client = new Temporal.Client();
  
  await client.workflow.start('agentExecutionWorkflow', {
    taskQueue: 'agent-tasks',
    workflowId: `agent-${agentRole}-${taskId}`,
    args: [{ taskId, agentRole, context }],
    retry: {
      initialInterval: '1s',
      maximumInterval: '1m',
      maximumAttempts: 3
    }
  });
}

// Sanitization
function sanitizeLLMOutput(output) {
  // Remove potential prompt injection patterns
  return output
    .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
    .replace(/javascript:/gi, '')
    .substring(0, 50000); // Hard limit
}

// Main execution with full error handling
app.post('/api/feed-context', async (req, res) => {
  const requestId = crypto.randomUUID();
  
  try {
    // Validate
    const { error, value } = contextSchema.validate(req.body);
    if (error) {
      return res.status(400).json({ 
        error: 'Validation failed', 
        details: error.details,
        requestId 
      });
    }

    // Rate limit by user (if authenticated)
    const userKey = req.headers['x-user-id'] || req.ip;
    const { data: limitCheck } = await supabase.rpc('check_rate_limit', {
      p_key: userKey,
      p_max_requests: 10,
      p_window_seconds: 60
    });

    if (!limitCheck) {
      return res.status(429).json({ error: 'Rate limit exceeded', requestId });
    }

    // Store context
    const { data: context, error: dbError } = await supabase
      .from('proxy_context')
      .insert({
        raw_input: sanitizeLLMOutput(value.raw_input),
        input_type: value.input_type,
        project_tag: value.project_tag,
        metadata: value.metadata,
        request_id: requestId,
        user_ip: req.ip
      })
      .select()
      .single();

    if (dbError) throw dbError;

    // Async delegation (don't block response)
    setImmediate(() => analyzeAndDelegateAsync(context));

    res.json({
      status: 'accepted',
      context_id: context.id,
      request_id: requestId,
      estimated_completion: '30-60s'
    });

  } catch (err) {
    logger.error('Feed context failed', { error: err.message, requestId });
    res.status(500).json({ 
      error: 'Internal server error', 
      requestId,
      retryable: true 
    });
  }
});

// Health check with dependency verification
app.get('/health', async (req, res) => {
  const checks = await Promise.all([
    checkSupabase(),
    checkLLMProviders(),
    checkDiskSpace()
  ]);
  
  const healthy = checks.every(c => c.status === 'ok');
  
  res.status(healthy ? 200 : 503).json({
    status: healthy ? 'healthy' : 'degraded',
    checks: Object.fromEntries(checks.map(c => [c.name, c.status])),
    timestamp: new Date().toISOString()
  });
});

app/layout.tsx

import type { Metadata, Viewport } from 'next';
import { Inter } from 'next/font/google';
import './globals.css';

const inter = Inter({ 
  subsets: ['latin'],
  variable: '--font-inter',
});

export const metadata: Metadata = {
  title: 'ProxyOS | AI Swarm Command',
  description: 'Gamified autonomous AI execution environment',
  manifest: '/manifest.json',
};

export const viewport: Viewport = {
  width: 'device-width',
  initialScale: 1,
  maximumScale: 1,
  themeColor: '#000000',
};

export default function RootLayout({
  children,
}: {
  children: React.ReactNode;
}) {
  return (
    <html lang="en" className="dark">
      <body className={`${inter.variable} font-sans`}>
        {children}
      </body>
    </html>
  );
}
app/page.tsx (Main Application)

'use client';

import { useState, useEffect, useRef } from 'react';
import dynamic from 'next/dynamic';
import { createClient } from '@supabase/supabase-js';
import { 
  Activity, Mic, Send, Terminal, Search, LineChart, 
  X, Database, Loader2, CheckCircle2, AlertCircle,
  Menu, Zap, Folder, FileText, ChevronRight, Pause,
  Play, RotateCcw, Settings, User
} from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';

// Dynamic import Phaser to avoid SSR issues
const OfficeCanvas = dynamic(() => import('@/components/OfficeCanvas'), {
  ssr: false,
  loading: () => (
    <div className="w-full h-[60vh] flex items-center justify-center">
      <div className="flex flex-col items-center gap-4">
        <div className="w-12 h-12 border-2 border-blue-500/30 border-t-blue-500 rounded-full animate-spin" />
        <p className="text-white/50 text-sm tracking-wide">Initializing Office...</p>
      </div>
    </div>
  ),
});

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!
);

// Types
interface Task {
  id: string;
  agent_role: 'minion' | 'scout' | 'sage';
  task_description: string;
  status: 'pending' | 'working' | 'success' | 'failed' | 'halted';
  created_at: string;
  output_log?: string;
}

interface ProxyStats {
  energy_level: number;
  tasks_completed: number;
  projects_active: number;
}

export default function Home() {
  const [context, setContext] = useState('');
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [drawerOpen, setDrawerOpen] = useState(false);
  const [vaultOpen, setVaultOpen] = useState(false);
  const [activeTab, setActiveTab] = useState<'office' | 'proxy'>('office');
  const [tasks, setTasks] = useState<Task[]>([]);
  const [stats, setStats] = useState<ProxyStats>({ energy_level: 50, tasks_completed: 0, projects_active: 0 });
  const [isListening, setIsListening] = useState(false);
  const [notifications, setNotifications] = useState<{id: string, message: string, type: string}[]>([]);

  // Real-time subscription
  useEffect(() => {
    fetchInitialData();
    
    const channel = supabase
      .channel('schema-db-changes')
      .on(
        'postgres_changes',
        { event: '*', schema: 'public', table: 'agent_tasks' },
        (payload) => {
          handleTaskUpdate(payload.new as Task);
        }
      )
      .on(
        'postgres_changes',
        { event: '*', schema: 'public', table: 'proxy_stats' },
        (payload) => {
          setStats(payload.new as ProxyStats);
        }
      )
      .subscribe();

    return () => {
      supabase.removeChannel(channel);
    };
  }, []);

  const fetchInitialData = async () => {
    const { data: tasksData } = await supabase
      .from('agent_tasks')
      .select('*')
      .order('created_at', { ascending: false })
      .limit(20);
    
    if (tasksData) setTasks(tasksData);

    const { data: statsData } = await supabase
      .from('proxy_stats')
      .select('*')
      .single();
    
    if (statsData) setStats(statsData);
  };

  const handleTaskUpdate = (task: Task) => {
    setTasks(prev => {
      const exists = prev.find(t => t.id === task.id);
      if (exists) {
        return prev.map(t => t.id === task.id ? task : t);
      }
      return [task, ...prev].slice(0, 20);
    });

    if (task.status === 'success') {
      addNotification(`${task.agent_role} completed task`, 'success');
    } else if (task.status === 'failed') {
      addNotification(`${task.agent_role} task failed`, 'error');
    }
  };

  const addNotification = (message: string, type: string) => {
    const id = Math.random().toString(36).substr(2, 9);
    setNotifications(prev => [...prev, { id, message, type }]);
    setTimeout(() => {
      setNotifications(prev => prev.filter(n => n.id !== id));
    }, 3000);
  };

  const handleSubmit = async () => {
    if (!context.trim() || isSubmitting) return;
    
    setIsSubmitting(true);
    
    try {
      const response = await fetch(`${process.env.NEXT_PUBLIC_BACKEND_URL}/api/feed-context`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          raw_input: context,
          input_type: 'text',
          project_tag: 'general'
        }),
      });

      if (response.ok) {
        setContext('');
        addNotification('Context fed to swarm', 'success');
      }
    } catch (err) {
      addNotification('Failed to feed context', 'error');
    } finally {
      setIsSubmitting(false);
    }
  };

  const handleVoiceInput = () => {
    if (!('webkitSpeechRecognition' in window)) {
      addNotification('Voice input not supported', 'error');
      return;
    }

    const recognition = new (window as any).webkitSpeechRecognition();
    recognition.continuous = false;
    recognition.interimResults = false;

    recognition.onstart = () => setIsListening(true);
    recognition.onend = () => setIsListening(false);
    recognition.onresult = (event: any) => {
      const transcript = event.results[0][0].transcript;
      setContext(prev => prev + ' ' + transcript);
    };

    recognition.start();
  };

  return (
    <main className="min-h-screen bg-[#050505] text-white overflow-hidden relative">
      {/* Animated Background */}
      <div className="absolute inset-0 overflow-hidden pointer-events-none">
        <div className="absolute top-0 left-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-[128px] animate-pulse" />
        <div className="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-[128px] animate-pulse delay-1000" />
      </div>

      {/* Top Navigation */}
      <nav className="relative z-20 flex items-center justify-between px-6 py-4 border-b border-white/5 bg-black/20 backdrop-blur-xl">
        <div className="flex items-center gap-3">
          <div className="relative">
            <div className="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/20">
              <Zap className="w-5 h-5 text-white" />
            </div>
            <div className="absolute -top-1 -right-1 w-3 h-3 bg-emerald-400 rounded-full border-2 border-black animate-pulse" />
          </div>
          <div>
            <h1 className="text-lg font-semibold tracking-tight">ProxyOS</h1>
            <p className="text-xs text-white/40 tracking-wider">SWARM ONLINE</p>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <button 
            onClick={() => setActiveTab('office')}
            className={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${
              activeTab === 'office' 
                ? 'bg-white/10 text-white' 
                : 'text-white/50 hover:text-white hover:bg-white/5'
            }`}

          >

            Office
          </button>
          <button 
            onClick={() => setActiveTab('proxy')}
            className={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${
              activeTab === 'proxy' 
                ? 'bg-white/10 text-white' 
                : 'text-white/50 hover:text-white hover:bg-white/5'
            }`}

          >

            My Proxy
          </button>
        </div>

        <div className="flex items-center gap-3">
          <button 
            onClick={() => setVaultOpen(true)}
            className="p-2 text-white/60 hover:text-white hover:bg-white/10 rounded-lg transition-all"

          >

            <Database className="w-5 h-5" />
          </button>
          <button 
            onClick={() => setDrawerOpen(true)}
            className="relative p-2 text-white/60 hover:text-white hover:bg-white/10 rounded-lg transition-all"

          >

            <Terminal className="w-5 h-5" />
            {tasks.filter(t => t.status === 'working').length > 0 && (
              <span className="absolute top-1 right-1 w-2 h-2 bg-blue-400 rounded-full animate-pulse" />
            )}
          </button>
          <div className="flex items-center gap-2 pl-4 border-l border-white/10">
            <div className="w-8 h-8 bg-gradient-to-br from-emerald-500/20 to-blue-500/20 rounded-full border border-white/10 flex items-center justify-center">
              <User className="w-4 h-4 text-white/70" />
            </div>
            <div className="hidden sm:block text-right">
              <p className="text-sm font-medium text-white/90">Energy</p>
              <div className="w-20 h-1.5 bg-white/10 rounded-full mt-1 overflow-hidden">
                <div 
                  className="h-full bg-gradient-to-r from-emerald-400 to-blue-400 transition-all duration-500"
                  style={{ width: `${stats.energy_level}%` }}
                />
              </div>
            </div>
          </div>
        </div>
      </nav>

      {/* Main Content Area */}
      <div className="relative z-10 h-[calc(100vh-80px)]">
        {activeTab === 'office' ? (
          <div className="h-full relative">
            <OfficeCanvas tasks={tasks} />
            
            {/* Command Center Overlay */}
            <div className="absolute bottom-8 left-1/2 transform -translate-x-1/2 w-[90%] max-w-2xl">
              <motion.div 
                initial={{ y: 20, opacity: 0 }}
                animate={{ y: 0, opacity: 1 }}
                className="flex items-center gap-3 p-2 glass rounded-full shadow-2xl shadow-black/50"

              >

                <div className="relative flex items-center justify-center w-10 h-10 ml-2 bg-gradient-to-tr from-blue-500/20 to-purple-500/20 rounded-full border border-white/10 animate-pulse-glow">
                  <Activity className="w-5 h-5 text-blue-400" />
                </div>

                <input
                  type="text"
                  value={context}
                  onChange={(e) => setContext(e.target.value)}
                  onKeyDown={(e) => e.key === 'Enter' && handleSubmit()}
                  placeholder="Feed context to the swarm..."
                  className="flex-1 bg-transparent border-none text-white text-[15px] font-medium tracking-wide placeholder-white/30 focus:outline-none focus:ring-0 px-2"
                />

                <div className="flex items-center gap-2 pr-1">
                  <button 
                    onClick={handleVoiceInput}
                    className={`p-2.5 rounded-full transition-all ${
                      isListening 
                        ? 'bg-red-500/20 text-red-400 animate-pulse' 
                        : 'text-white/60 hover:text-white hover:bg-white/10'
                    }`}

                  >

                    <Mic className="w-5 h-5" />
                  </button>
                  
                  <button 
                    onClick={handleSubmit}
                    disabled={!context.trim() || isSubmitting}
                    className={`flex items-center justify-center w-10 h-10 rounded-full transition-all duration-300 ${
                      context.trim() && !isSubmitting
                        ? 'bg-white text-black shadow-[0_0_20px_rgba(255,255,255,0.3)] hover:scale-105 hover:shadow-[0_0_30px_rgba(255,255,255,0.5)]' 
                        : 'bg-white/10 text-white/40 cursor-not-allowed'
                    }`}

                  >

                    {isSubmitting ? (
                      <Loader2 className="w-4 h-4 animate-spin" />
                    ) : (
                      <Send className="w-4 h-4 translate-x-[1px]" />
                    )}
                  </button>
                </div>
              </motion.div>
            </div>
          </div>
        ) : (
          <ProxyDashboard stats={stats} />
        )}
      </div>

      {/* Swarm Activity Drawer */}
      <AnimatePresence>
        {drawerOpen && (
          <>
            <motion.div 
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => setDrawerOpen(false)}
              className="fixed inset-0 bg-black/60 backdrop-blur-sm z-40"
            />
            <motion.div 
              initial={{ x: '100%' }}
              animate={{ x: 0 }}
              exit={{ x: '100%' }}
              transition={{ type: 'spring', damping: 25, stiffness: 200 }}
              className="fixed top-0 right-0 h-full w-full sm:w-[420px] bg-[#0a0a0a]/95 backdrop-blur-3xl border-l border-white/10 z-50 shadow-2xl"

            >

              <div className="flex flex-col h-full">
                <div className="flex items-center justify-between px-6 py-5 border-b border-white/5">
                  <div>
                    <h2 className="text-lg font-semibold tracking-tight text-white">Swarm Activity</h2>
                    <p className="text-xs text-white/40 mt-1 uppercase tracking-widest">
                      {tasks.filter(t => t.status === 'working').length} Active • {tasks.filter(t => t.status === 'pending').length} Queued
                    </p>
                  </div>
                  <button 
                    onClick={() => setDrawerOpen(false)}
                    className="p-2 text-white/50 hover:text-white bg-white/5 rounded-full hover:bg-white/10 transition-all"

                  >

                    <X className="w-4 h-4" />
                  </button>
                </div>

                <div className="flex-1 overflow-y-auto p-4 space-y-3 custom-scrollbar">
                  {tasks.length === 0 ? (
                    <div className="flex flex-col items-center justify-center h-64 text-white/30">
                      <Terminal className="w-12 h-12 mb-4 opacity-50" />
                      <p className="text-sm">No tasks yet</p>
                      <p className="text-xs mt-1">Feed context to activate agents</p>
                    </div>
                  ) : (
                    tasks.map((task) => (
                      <TaskCard key={task.id} task={task} />
                    ))
                  )}
                </div>

                <div className="p-4 border-t border-white/5 bg-white/[0.02]">
                  <div className="flex items-center justify-between text-xs text-white/40 mb-3">
                    <span>System Status</span>
                    <span className="flex items-center gap-1.5">
                      <span className="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse" />
                      Operational
                    </span>
                  </div>
                  <div className="grid grid-cols-3 gap-2">
                    <AgentStatusBadge role="minion" tasks={tasks} />
                    <AgentStatusBadge role="scout" tasks={tasks} />
                    <AgentStatusBadge role="sage" tasks={tasks} />
                  </div>
                </div>
              </div>
            </motion.div>
          </>
        )}
      </AnimatePresence>

      {/* Memory Vault Modal */}
      <AnimatePresence>
        {vaultOpen && <MemoryVault onClose={() => setVaultOpen(false)} />}
      </AnimatePresence>

      {/* Notifications */}
      <div className="fixed top-20 right-6 z-50 flex flex-col gap-2 pointer-events-none">
        <AnimatePresence>
          {notifications.map((notif) => (
            <motion.div
              key={notif.id}
              initial={{ opacity: 0, x: 50, scale: 0.9 }}
              animate={{ opacity: 1, x: 0, scale: 1 }}
              exit={{ opacity: 0, x: 50, scale: 0.9 }}
              className={`pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border shadow-lg ${
                notif.type === 'success' 
                  ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400' 
                  : 'bg-red-500/10 border-red-500/20 text-red-400'
              }`}

            >

              {notif.type === 'success' ? <CheckCircle2 className="w-4 h-4" /> : <AlertCircle className="w-4 h-4" />}
              <span className="text-sm font-medium">{notif.message}</span>
            </motion.div>
          ))}
        </AnimatePresence>
      </div>
    </main>
  );
}

// Sub-components

function TaskCard({ task }: { task: Task }) {
  const getIcon = () => {
    switch (task.agent_role) {
      case 'minion': return <Terminal className="w-4 h-4 text-emerald-400" />;
      case 'scout': return <Search className="w-4 h-4 text-blue-400" />;
      case 'sage': return <LineChart className="w-4 h-4 text-purple-400" />;
      default: return <Activity className="w-4 h-4 text-white/40" />;
    }
  };

  const getStatusColor = () => {
    switch (task.status) {
      case 'working': return 'text-blue-400 bg-blue-400/10 border-blue-400/20';
      case 'success': return 'text-emerald-400 bg-emerald-400/10 border-emerald-400/20';
      case 'failed': return 'text-red-400 bg-red-400/10 border-red-400/20';
      case 'halted': return 'text-amber-400 bg-amber-400/10 border-amber-400/20';
      default: return 'text-white/40 bg-white/5 border-white/10';
    }
  };

  return (
    <motion.div 
      layout
      className="group relative bg-white/[0.03] border border-white/5 rounded-2xl p-4 hover:bg-white/[0.06] hover:border-white/10 transition-all duration-300"

    >

      <div className="flex items-start justify-between mb-3">
        <div className="flex items-center gap-3">
          <div className={`p-2 rounded-xl border ${task.status === 'working' ? 'bg-black/50 border-white/10 shadow-[0_0_15px_rgba(255,255,255,0.05)]' : 'bg-transparent border-white/5'}`}>
            {getIcon()}
          </div>
          <div>
            <h3 className="text-sm font-medium text-white/90 capitalize flex items-center gap-2">
              {task.agent_role}
              {task.status === 'working' && (
                <span className="flex h-2 w-2 relative">
                  <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75" />
                  <span className="relative inline-flex rounded-full h-2 w-2 bg-blue-500" />
                </span>
              )}
            </h3>
            <p className="text-[10px] uppercase tracking-wider text-white/40 mt-0.5">
              {new Date(task.created_at).toLocaleTimeString()}
            </p>
          </div>
        </div>
        <span className={`text-[10px] uppercase tracking-wider px-2 py-1 rounded-full border ${getStatusColor()}`}>
          {task.status}
        </span>
      </div>

      <p className="text-sm text-white/70 leading-relaxed font-light line-clamp-2 mb-3">
        {task.task_description}
      </p>

      {task.status === 'working' && (
        <div className="flex items-center gap-2 mt-3 pt-3 border-t border-white/5">
          <button className="opacity-0 group-hover:opacity-100 transition-all text-xs text-red-400 hover:text-red-300 font-medium tracking-wide bg-red-400/10 px-3 py-1.5 rounded-lg hover:bg-red-400/20">
            Halt
          </button>
          <div className="flex-1 h-1 bg-white/10 rounded-full overflow-hidden">
            <div className="h-full bg-blue-500/50 rounded-full animate-[loading_2s_ease-in-out_infinite]" style={{ width: '60%' }} />
          </div>
        </div>
      )}

      {task.output_log && task.status === 'success' && (
        <div className="mt-3 pt-3 border-t border-white/5">
          <p className="text-xs text-emerald-400/80 font-mono line-clamp-2">
            {typeof task.output_log === 'string' ? task.output_log.substring(0, 100) : 'Task completed successfully'}
          </p>
        </div>
      )}
    </motion.div>
  );
}

function AgentStatusBadge({ role, tasks }: { role: string, tasks: Task[] }) {
  const activeCount = tasks.filter(t => t.agent_role === role && t.status === 'working').length;
  const Icon = role === 'minion' ? Terminal : role === 'scout' ? Search : LineChart;
  
  return (
    <div className={`flex flex-col items-center p-3 rounded-xl border transition-all ${
      activeCount > 0 ? 'bg-white/5 border-white/10' : 'bg-transparent border-white/5 opacity-50'
    }`}>
      <Icon className={`w-4 h-4 mb-1 ${activeCount > 0 ? 'text-white' : 'text-white/40'}`} />
      <span className="text-[10px] uppercase tracking-wider text-white/60">{role}</span>
      {activeCount > 0 && (
        <span className="text-xs font-semibold text-blue-400 mt-1">{activeCount}</span>
      )}
    </div>
  );
}

function ProxyDashboard({ stats }: { stats: ProxyStats }) {
  const abilities = [
    { name: 'Code Generation', level: 85, icon: Terminal, color: 'emerald' },
    { name: 'Research', level: 92, icon: Search, color: 'blue' },
    { name: 'Strategy', level: 78, icon: LineChart, color: 'purple' },
  ];

  return (
    <div className="h-full flex items-center justify-center p-8">
      <div className="max-w-4xl w-full grid grid-cols-1 md:grid-cols-2 gap-8">
        <div className="space-y-6">
          <div className="glass-strong rounded-3xl p-8 text-center">
            <div className="relative inline-block mb-6">
              <div className="w-32 h-32 bg-gradient-to-br from-blue-500/20 to-purple-500/20 rounded-full border-2 border-white/10 flex items-center justify-center animate-float">
                <User className="w-16 h-16 text-white/80" />
              </div>
              <div className="absolute -bottom-2 -right-2 w-10 h-10 bg-emerald-500 rounded-full border-4 border-[#0a0a0a] flex items-center justify-center">
                <Zap className="w-5 h-5 text-white" />
              </div>
            </div>
            <h2 className="text-2xl font-semibold text-white mb-2">Your Proxy</h2>
            <p className="text-white/50 text-sm mb-6">Level {Math.floor(stats.tasks_completed / 10) + 1} Operator</p>
            
            <div className="space-y-3">
              <div className="flex justify-between text-sm">
                <span className="text-white/60">Energy</span>
                <span className="text-white font-medium">{stats.energy_level}%</span>
              </div>
              <div className="h-3 bg-white/10 rounded-full overflow-hidden">
                <div 
                  className="h-full bg-gradient-to-r from-emerald-400 via-blue-400 to-purple-400 transition-all duration-500"
                  style={{ width: `${stats.energy_level}%` }}
                />
              </div>
            </div>
          </div>

          <div className="glass rounded-2xl p-6">
            <h3 className="text-sm font-semibold text-white/80 mb-4 uppercase tracking-wider">Statistics</h3>
            <div className="grid grid-cols-2 gap-4">
              <div className="bg-white/5 rounded-xl p-4">
                <p className="text-2xl font-bold text-white">{stats.tasks_completed}</p>
                <p className="text-xs text-white/40 uppercase tracking-wider mt-1">Tasks Completed</p>
              </div>
              <div className="bg-white/5 rounded-xl p-4">
                <p className="text-2xl font-bold text-white">{stats.projects_active}</p>
                <p className="text-xs text-white/40 uppercase tracking-wider mt-1">Active Projects</p>
              </div>
            </div>
          </div>
        </div>

        <div className="space-y-4">
          <h3 className="text-sm font-semibold text-white/80 uppercase tracking-wider mb-4">Agent Abilities</h3>
          {abilities.map((ability) => (
            <div key={ability.name} className="glass rounded-2xl p-5 hover:bg-white/[0.05] transition-all">
              <div className="flex items-center justify-between mb-3">
                <div className="flex items-center gap-3">
                  <div className={`p-2 rounded-lg bg-${ability.color}-500/20`}>
                    <ability.icon className={`w-5 h-5 text-${ability.color}-400`} />
                  </div>
                  <span className="text-white font-medium">{ability.name}</span>
                </div>
                <span className="text-white/60 text-sm">{ability.level}%</span>
              </div>
              <div className="h-2 bg-white/10 rounded-full overflow-hidden">
                <div 
                  className={`h-full bg-${ability.color}-400 rounded-full transition-all duration-1000`}
                  style={{ width: `${ability.level}%` }}
                />
              </div>
            </div>
          ))}

          <div className="glass rounded-2xl p-5 mt-6">
            <h3 className="text-sm font-semibold text-white/80 mb-3">Recent Achievements</h3>
            <div className="flex flex-wrap gap-2">
              {['First Task', 'Swarm Online', 'Memory Sync', 'Voice Master'].map((achievement) => (
                <span key={achievement} className="px-3 py-1.5 bg-white/5 border border-white/10 rounded-full text-xs text-white/70">
                  {achievement}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

function MemoryVault({ onClose }: { onClose: () => void }) {
  const [memories, setMemories] = useState<any[]>([]);
  const [searchQuery, setSearchQuery] = useState('');

  useEffect(() => {
    fetchMemories();
  }, []);

  const fetchMemories = async () => {
    const { data } = await supabase.from('agent_memories').select('*');
    if (data) setMemories(data);
  };

  const filteredMemories = memories.filter(m => 
    m.agent_role.toLowerCase().includes(searchQuery.toLowerCase()) ||
    m.soul_markdown.toLowerCase().includes(searchQuery.toLowerCase())
  );

  return (
    <motion.div 
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      exit={{ opacity: 0 }}
      className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-3xl"

    >

      <motion.div 
        initial={{ scale: 0.95, opacity: 0 }}
        animate={{ scale: 1, opacity: 1 }}
        exit={{ scale: 0.95, opacity: 0 }}
        className="w-full max-w-5xl h-[85vh] bg-[#0a0a0a] border border-white/10 rounded-3xl shadow-2xl flex flex-col overflow-hidden"

      >

        <div className="flex items-center justify-between px-8 py-6 border-b border-white/5 bg-white/[0.02]">
          <div className="flex items-center gap-4">
            <div className="p-3 bg-white/5 rounded-2xl border border-white/10">
              <Database className="w-6 h-6 text-white/80" />
            </div>
            <div>
              <h2 className="text-2xl font-semibold text-white tracking-tight">Memory Vault</h2>
              <p className="text-sm text-white/40 tracking-wide mt-1">Long-term agent context storage</p>
            </div>
          </div>
          
          <div className="flex items-center gap-4">
            <div className="relative hidden md:flex items-center">
              <Search className="absolute left-3 w-4 h-4 text-white/30" />
              <input 
                type="text" 
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                placeholder="Search memories..." 
                className="pl-10 pr-4 py-2 bg-black/50 border border-white/10 rounded-full text-sm text-white placeholder-white/30 focus:outline-none focus:border-white/30 w-64 transition-all"
              />
            </div>
            <button 
              onClick={onClose} 
              className="p-2 text-white/50 hover:text-white bg-white/5 rounded-full hover:bg-white/10 transition-all"

            >

              <X className="w-5 h-5" />
            </button>
          </div>
        </div>

        <div className="flex-1 overflow-y-auto p-8 custom-scrollbar">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            {filteredMemories.map((memory) => (
              <motion.div 
                key={memory.agent_role}
                layout
                className="group relative bg-white/[0.03] border border-white/5 rounded-2xl p-6 hover:bg-white/[0.06] hover:border-white/20 transition-all duration-300"

              >

                <div className="flex justify-between items-start mb-4">
                  <div className="flex items-center gap-3">
                    <div className="p-2 bg-black/40 rounded-xl border border-white/5 group-hover:scale-110 transition-transform">
                      {memory.agent_role === 'minion' ? (
                        <Terminal className="w-5 h-5 text-emerald-400" />
                      ) : memory.agent_role === 'scout' ? (
                        <Search className="w-5 h-5 text-blue-400" />
                      ) : memory.agent_role === 'sage' ? (
                        <LineChart className="w-5 h-5 text-purple-400" />
                      ) : (
                        <User className="w-5 h-5 text-yellow-400" />
                      )}
                    </div>
                    <span className="text-xs font-bold uppercase tracking-widest text-white/50">
                      {memory.agent_role}
                    </span>
                  </div>
                  <span className="text-[10px] uppercase tracking-wider text-white/30">
                    v{memory.version}
                  </span>
                </div>

                <div className="space-y-4">
                  <div>
                    <h4 className="text-xs uppercase tracking-wider text-white/40 mb-2">Soul</h4>
                    <p className="text-sm text-white/70 line-clamp-3 font-light">
                      {memory.soul_markdown}
                    </p>
                  </div>
                  
                  <div>
                    <h4 className="text-xs uppercase tracking-wider text-white/40 mb-2">Recent Memory</h4>
                    <p className="text-sm text-white/50 line-clamp-3 font-light">
                      {memory.memory_markdown.substring(0, 150)}...
                    </p>
                  </div>
                </div>

                <div className="absolute bottom-0 left-0 w-0 h-[2px] bg-gradient-to-r from-blue-500/50 to-purple-500/50 group-hover:w-full transition-all duration-500 rounded-b-2xl" />
              </motion.div>
            ))}
          </div>
        </div>
      </motion.div>
    </motion.div>
  );
}
components/OfficeCanvas.tsx (Phaser Game Component)

'use client';

import { useEffect, useRef } from 'react';
import Phaser from 'phaser';

interface Task {
  id: string;
  agent_role: 'minion' | 'scout' | 'sage';
  status: string;
}

interface OfficeCanvasProps {
  tasks: Task[];
}

export default function OfficeCanvas({ tasks }: OfficeCanvasProps) {
  const gameRef = useRef<Phaser.Game | null>(null);
  const containerRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (typeof window === 'undefined') return;

    class OfficeScene extends Phaser.Scene {
      private agents: Map<string, Phaser.GameObjects.Container> = new Map();
      private particles: Phaser.GameObjects.Particles.ParticleEmitterManager | null = null;
      private taskIndicators: Map<string, Phaser.GameObjects.Text> = new Map();

      constructor() {
        super({ key: 'OfficeScene' });
      }

      preload() {
        // Generate pixel art textures programmatically
        this.load.setBaseURL('');
        
        // Create textures programmatically instead of loading images
        this.createPixelTextures();
      }

      createPixelTextures() {
        // Create agent textures
        const graphics = this.make.graphics({ x: 0, y: 0, add: false });
        
        // Minion texture (green coder)
        graphics.fillStyle(0x10b981);
        graphics.fillRect(0, 0, 32, 48);
        graphics.fillStyle(0x064e3b);
        graphics.fillRect(8, 8, 16, 8); // Glasses
        graphics.generateTexture('minion', 32, 48);
        graphics.clear();

        // Scout texture (blue researcher)
        graphics.fillStyle(0x3b82f6);
        graphics.fillRect(0, 0, 32, 48);
        graphics.fillStyle(0x1e40af);
        graphics.fillRect(4, 4, 24, 8); // Headphones
        graphics.generateTexture('scout', 32, 48);
        graphics.clear();

        // Sage texture (purple strategist)
        graphics.fillStyle(0xa855f7);
        graphics.fillRect(0, 0, 32, 48);
        graphics.fillStyle(0x581c87);
        graphics.fillRect(0, 0, 32, 8); // Hat/vest
        graphics.generateTexture('sage', 32, 48);
        graphics.clear();

        // Proxy texture (white/blue avatar)
        graphics.fillStyle(0x60a5fa);
        graphics.fillRect(0, 0, 40, 56);
        graphics.fillStyle(0xffffff);
        graphics.fillRect(12, 8, 16, 12); // Face
        graphics.generateTexture('proxy', 40, 56);
        graphics.clear();

        // Desk texture
        graphics.fillStyle(0x374151);
        graphics.fillRect(0, 0, 80, 40);
        graphics.fillStyle(0x4b5563);
        graphics.fillRect(5, 5, 70, 5); // Detail
        graphics.generateTexture('desk', 80, 40);
        graphics.clear();

        // Computer texture
        graphics.fillStyle(0x1f2937);
        graphics.fillRect(0, 0, 24, 20);
        graphics.fillStyle(0x10b981);
        graphics.fillRect(4, 4, 16, 12); // Screen glow
        graphics.generateTexture('computer', 24, 20);
        graphics.clear();

        // Particle texture
        graphics.fillStyle(0x60a5fa);
        graphics.fillCircle(4, 4, 4);
        graphics.generateTexture('particle', 8, 8);
        graphics.destroy();
      }

      create() {
        const width = this.scale.width;
        const height = this.scale.height;

        // Background grid
        const grid = this.add.grid(width/2, height/2, width, height, 40, 40, 0x0a0a0a, 1, 0x1a1a1a, 0.5);
        
        // Office floor
        this.add.rectangle(width/2, height/2, width - 40, height - 40, 0x111111);

        // Create desks and agents
        this.createAgentStation('minion', width * 0.2, height * 0.6, 'Minion', 'Code & Deploy');
        this.createAgentStation('scout', width * 0.5, height * 0.4, 'Scout', 'Research');
        this.createAgentStation('sage', width * 0.8, height * 0.6, 'Sage', 'Strategy');

        // Proxy (manager) station - center bottom
        this.createProxyStation(width * 0.5, height * 0.75);

        // Ambient particles
        this.particles = this.add.particles(0, 0, 'particle', {
          x: { min: 0, max: width },
          y: { min: 0, max: height },
          lifespan: 4000,
          speedY: { min: -10, max: -30 },
          scale: { start: 0.4, end: 0 },
          quantity: 2,
          frequency: 100,
          alpha: { start: 0.3, end: 0 }
        });

        // Listen for task updates
        this.game.events.on('taskUpdate', this.handleTaskUpdate, this);

        // Idle animations
        this.time.addEvent({
          delay: 3000,
          loop: true,
          callback: () => this.playIdleAnimations()
        });
      }

      createAgentStation(key: string, x: number, y: number, name: string, role: string) {
        const container = this.add.container(x, y);
        
        // Desk
        const desk = this.add.image(0, 20, 'desk').setOrigin(0.5);
        
        // Computer
        const computer = this.add.image(0, -10, 'computer').setOrigin(0.5);
        
        // Agent sprite
        const agent = this.add.sprite(0, -40, key).setOrigin(0.5);
        
        // Name label
        const nameText = this.add.text(0, 50, name, {
          fontSize: '12px',
          color: '#ffffff',
          fontFamily: 'Inter, sans-serif'
        }).setOrigin(0.5);

        // Role label
        const roleText = this.add.text(0, 65, role, {
          fontSize: '10px',
          color: '#6b7280',
          fontFamily: 'Inter, sans-serif'
        }).setOrigin(0.5);

        // Status indicator
        const statusCircle = this.add.circle(25, -55, 4, 0x10b981);
        
        container.add([desk, computer, agent, nameText, roleText, statusCircle]);
        this.agents.set(key, container);

        // Idle animation
        this.tweens.add({
          targets: agent,
          y: -45,
          duration: 2000,
          yoyo: true,
          repeat: -1,
          ease: 'Sine.easeInOut'
        });

        // Computer glow pulse
        this.tweens.add({
          targets: computer,
          alpha: 0.7,
          duration: 1500,
          yoyo: true,
          repeat: -1,
          ease: 'Sine.easeInOut'
        });
      }

      createProxyStation(x: number, y: number) {
        const container = this.add.container(x, y);
        
        // Manager desk (larger)
        const desk = this.add.rectangle(0, 20, 120, 50, 0x1e40af);
        
        // Proxy avatar
        const proxy = this.add.sprite(0, -35, 'proxy').setOrigin(0.5);
        
        // Tablet
        const tablet = this.add.rectangle(15, -25, 20, 15, 0x60a5fa);
        
        // Label
        const label = this.add.text(0, 55, 'PROXY', {
          fontSize: '14px',
          color: '#60a5fa',
          fontFamily: 'Inter, sans-serif',
          fontStyle: 'bold'
        }).setOrigin(0.5);

        container.add([desk, proxy, tablet, label]);
        this.agents.set('proxy', container);

        // Breathing animation
        this.tweens.add({
          targets: proxy,
          scaleX: 1.05,
          scaleY: 1.05,
          duration: 3000,
          yoyo: true,
          repeat: -1,
          ease: 'Sine.easeInOut'
        });
      }

      handleTaskUpdate(task: Task) {
        const agent = this.agents.get(task.agent_role);
        if (!agent) return;

        const sprite = agent.list.find((c: any) => c instanceof Phaser.GameObjects.Sprite) as Phaser.GameObjects.Sprite;
        
        if (task.status === 'working') {
          // Working animation - faster bounce
          this.tweens.add({
            targets: sprite,
            y: -50,
            duration: 300,
            yoyo: true,
            repeat: 5,
            ease: 'Power2'
          });

          // Add "typing" particles
          const particles = this.add.particles(sprite.x + agent.x, sprite.y + agent.y - 20, 'particle', {
            speed: { min: -20, max: 20 },
            speedY: { min: -50, max: -100 },
            scale: { start: 0.3, end: 0 },
            lifespan: 800,
            quantity: 1,
            frequency: 100,
            tint: task.agent_role === 'minion' ? 0x10b981 : task.agent_role === 'scout' ? 0x3b82f6 : 0xa855f7
          });

          // Stop after 3 seconds
          this.time.delayedCall(3000, () => particles.destroy());

        } else if (task.status === 'success') {
          // Success animation - green flash
          this.cameras.main.flash(300, 0, 255, 0, 0.2);
          
          // Floating checkmark
          const check = this.add.text(agent.x, agent.y - 80, '✓', {
            fontSize: '24px',
            color: '#10b981'
          }).setOrigin(0.5);

          this.tweens.add({
            targets: check,
            y: agent.y - 120,
            alpha: 0,
            duration: 1500,
            onComplete: () => check.destroy()
          });
        }
      }

      playIdleAnimations() {
        // Random subtle movements
        this.agents.forEach((container, key) => {
          if (key === 'proxy') return;
          
          const sprite = container.list.find((c: any) => c instanceof Phaser.GameObjects.Sprite) as Phaser.GameObjects.Sprite;
          if (sprite && Math.random() > 0.7) {
            this.tweens.add({
              targets: sprite,
              x: Phaser.Math.Between(-5, 5),
              duration: 500,
              yoyo: true
            });
          }
        });
      }

      update() {
        // Continuous updates if needed
      }
    }

    const config: Phaser.Types.Core.GameConfig = {
      type: Phaser.AUTO,
      width: containerRef.current?.clientWidth || 800,
      height: containerRef.current?.clientHeight || 600,
      parent: containerRef.current,
      transparent: true,
      scene: OfficeScene,
      scale: {
        mode: Phaser.Scale.RESIZE,
        autoCenter: Phaser.Scale.CENTER_BOTH
      },
      pixelArt: true
    };

    gameRef.current = new Phaser.Game(config);

    return () => {
      if (gameRef.current) {
        gameRef.current.destroy(true);
        gameRef.current = null;
      }
    };
  }, []);

  // Update game when tasks change
  useEffect(() => {
    if (gameRef.current) {
      const scene = gameRef.current.scene.getScene('OfficeScene');
      if (scene) {
        tasks.forEach(task => {
          scene.game.events.emit('taskUpdate', task);
        });
      }
    }
  }, [tasks]);

  return (
    <div 
      ref={containerRef} 
      className="w-full h-full min-h-[500px]"
      style={{ imageRendering: 'pixelated' }}
    />
  );
}
